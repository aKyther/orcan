# Closed build context: runtime inputs only, never plugin environments or tests.
**
!Dockerfile
!.dockerignore
!docker/
!docker/**
!plugins/
!plugins/**
!requirements-actions.txt
plugins/cockpit/tests/
plugins/cockpit/smoke/
plugins/redis/tests/
plugins/redis/smoke/
**/.venv/
**/.venv-docs/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.env
**/.env.*
**/.git/
**/node_modules/

!plugins/redis/smoke/
plugins/redis/smoke/*
!plugins/redis/smoke/fake_codex.py
!plugins/redis/smoke/load.py
