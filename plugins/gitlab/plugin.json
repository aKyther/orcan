{
  "version": 1,
  "id": "gitlab",
  "kind": "access",
  "title": "GitLab",
  "group": "access",
  "flags": [
    "--gitlab",
    "--with-gitlab"
  ],
  "fields": {
    "hostname": {
      "type": "string",
      "default": "gitlab.com",
      "format": "hostname",
      "flag": "--gitlab-hostname",
      "label": "GitLab hostname"
    }
  },
  "verifier": "gitlab",
  "enabled": false,
  "requires": [],
  "conflicts": [],
  "image_requires": [
    "glab"
  ],
  "host_requires": [
    "GitLab token or glab login"
  ]
}
