{
  "version": 1,
  "id": "ttyd",
  "kind": "interface",
  "title": "Browser terminal",
  "group": "interface",
  "flags": [
    "--with-ttyd",
    "--web-terminal"
  ],
  "secret_flags": [
    "--with-ttyd-auth",
    "--web-terminal-auth"
  ],
  "legacy_section": "ttyd",
  "fields": {
    "port": {
      "type": "integer",
      "default": 7681,
      "label": "Port",
      "minimum": 1,
      "maximum": 65535,
      "env": "TTYD_PORT",
      "help": "Container terminal port."
    },
    "host_port": {
      "type": "integer",
      "default": 7681,
      "label": "Host port",
      "minimum": 1,
      "maximum": 65535,
      "env": "TTYD_HOST_PORT",
      "help": "Browser terminal port on the host; choose a free port. Container port is configured separately."
    },
    "bind": {
      "type": "string",
      "default": "0.0.0.0",
      "label": "Bind",
      "env": "TTYD_BIND",
      "help": "Host listening interface: 127.0.0.1 for local access or 0.0.0.0 for all IPv4 interfaces."
    },
    "font_size": {
      "type": "integer",
      "default": 14,
      "label": "Font size",
      "minimum": 6,
      "maximum": 72,
      "env": "TTYD_FONT_SIZE"
    },
    "font_family": {
      "type": "string",
      "default": "Menlo, Monaco, 'Courier New', monospace",
      "label": "Font family",
      "env": "TTYD_FONT_FAMILY"
    },
    "renderer": {
      "type": "string",
      "default": "webgl",
      "label": "Renderer",
      "choices": [
        "webgl",
        "canvas"
      ],
      "env": "TTYD_RENDERER"
    },
    "theme": {
      "type": "string",
      "default": "dark",
      "label": "Theme",
      "env": "TTYD_THEME"
    },
    "ping_interval": {
      "type": "integer",
      "default": 20,
      "label": "Ping interval",
      "minimum": 1,
      "maximum": 3600,
      "env": "TTYD_PING_INTERVAL"
    },
    "authentication": {
      "type": "string",
      "default": "none",
      "choices": [
        "none",
        "basic"
      ],
      "label": "Authentication (none/basic)",
      "env": "TTYD_AUTHENTICATION",
      "help": "none or basic. Basic requires a transient TTYD_CREDENTIAL or --web-terminal-auth USER:PASS at startup."
    }
  },
  "verifier": "ttyd",
  "enabled": false,
  "requires": [],
  "conflicts": [],
  "compose": "compose.yml",
  "image_requires": [
    "ttyd",
    "supervisor"
  ],
  "host_requires": [],
  "help": [
    "Publishes a browser terminal. Local orcan enter works without this plugin.",
    "Set bind to 127.0.0.1 for host-only access; 0.0.0.0 listens on all IPv4 interfaces.",
    "For basic authentication provide TTYD_CREDENTIAL to the launching process. Never save a password in JSON.",
    "After startup: orcan url. Changing published ports can recreate the container."
  ],
  "examples": [
    "{\"plugins\":{\"ttyd\":{\"enabled\":true,\"bind\":\"127.0.0.1\",\"host_port\":7681}}}"
  ]
}
