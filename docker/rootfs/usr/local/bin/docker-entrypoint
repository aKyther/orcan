#!/usr/bin/env bash
# Container entrypoint: initialize Cursor home defaults, then exec CMD.

set -Eeuo pipefail

INIT_SCRIPT="${INIT_CURSOR_HOME_SCRIPT:-/usr/local/bin/init-cursor-home}"

fix_named_volume_permissions() {
    # Named volumes mounted below image paths can be created root-owned on first use.
    local dir owner uid gid

    uid="$(id -u)"
    gid="$(id -g)"

    for dir in \
        "${HOME}/.config/cursor" \
        "${HOME}/.cursor"
    do
        [[ -e "${dir}" ]] || continue
        owner="$(stat -c '%u' "${dir}" 2>/dev/null || true)"
        if [[ -n "${owner}" && "${owner}" != "${uid}" ]]; then
            sudo chown -R "${uid}:${gid}" "${dir}"
        fi
    done
}

run_init() {
    if [[ ! -x "${INIT_SCRIPT}" ]]; then
        printf 'Warning: init script not found or not executable: %s\n' "${INIT_SCRIPT}" >&2
        return 0
    fi

    # Runs as the non-root image user. Created files already belong to that user.
    "${INIT_SCRIPT}"
}

main() {
    fix_named_volume_permissions
    run_init

    if [[ "$#" -eq 0 ]]; then
        set -- bash
    fi

    exec "$@"
}

main "$@"
