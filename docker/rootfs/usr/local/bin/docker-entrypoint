#!/usr/bin/env bash
# Container entrypoint: initialize Cursor home defaults, then exec CMD.

set -Eeuo pipefail

INIT_SCRIPT="${INIT_CURSOR_HOME_SCRIPT:-/usr/local/bin/init-cursor-home}"
INIT_CLAUDE_HOME_SCRIPT="${INIT_CLAUDE_HOME_SCRIPT:-/usr/local/bin/init-claude-home}"
AI_STATUSLINE_SCRIPT="${INIT_AI_STATUSLINE_SCRIPT:-/usr/local/bin/init-ai-statusline}"
WORKSPACE_SCRIPT="${INIT_WORKSPACE_SCRIPT:-/usr/local/bin/init-workspace}"

# Bake-time variant: full (Claude+Cursor) or claude (Claude only).
if [[ -z "${ORCAN_VARIANT:-}" && -r /etc/orcan/variant ]]; then
    ORCAN_VARIANT="$(tr -d '[:space:]' < /etc/orcan/variant)"
fi
export ORCAN_VARIANT="${ORCAN_VARIANT:-full}"

if [[ -z "${ORCAN_VERSION:-}" && -r /etc/orcan/version ]]; then
    ORCAN_VERSION="$(tr -d '[:space:]' < /etc/orcan/version)"
fi
export ORCAN_VERSION="${ORCAN_VERSION:-dev}"

fix_named_volume_permissions() {
    local dir uid gid

    uid="$(id -u)"
    gid="$(id -g)"

    for dir in \
        "${HOME}/.config/cursor" \
        "${HOME}/.cursor" \
        "${HOME}/.claude" \
        "${HOME}/.cache"
    do
        [[ -e "${dir}" ]] || continue
        if [[ "$(stat -c '%u' "${dir}")" != "${uid}" ]] \
            || [[ ! -w "${dir}" ]] \
            || find "${dir}" ! -user "${uid}" -print -quit 2>/dev/null | grep -q .; then
            sudo chown -R "${uid}:${gid}" "${dir}"
        fi
    done
}

# Claude Code: keep OAuth + ~/.claude.json under the mounted ~/.claude volume.
# Without CLAUDE_CONFIG_DIR, the CLI also writes ~/.claude.json in ephemeral HOME.
persist_claude_config() {
    local config_dir legacy
    config_dir="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
    export CLAUDE_CONFIG_DIR="${config_dir}"
    mkdir -p "${config_dir}"

    legacy="${HOME}/.claude.json"
    if [[ -f "${legacy}" && ! -L "${legacy}" ]]; then
        if [[ ! -e "${config_dir}/.claude.json" ]]; then
            mv -- "${legacy}" "${config_dir}/.claude.json"
        else
            rm -f -- "${legacy}"
        fi
    fi
    if [[ -f "${config_dir}/.claude.json" && ! -e "${legacy}" ]]; then
        ln -sfn "${config_dir}/.claude.json" "${legacy}"
    fi
}

create_project_symlinks() {
    if [[ -z "${PROJECT_DIR:-}" ]]; then
        return 0
    fi

    local home_link current
    for home_link in "${HOME}/project" "${HOME}/workspace"; do
        if [[ -n "${WORKSPACE_ROOT:-}" && -d "${WORKSPACE_ROOT}" ]]; then
            target="${WORKSPACE_ROOT}"
        else
            target="${PROJECT_DIR}"
        fi
        if [[ -L "${home_link}" ]]; then
            current="$(readlink "${home_link}")"
            if [[ "${current}" != "${target}" ]]; then
                ln -sfn "${target}" "${home_link}"
            fi
        elif [[ ! -e "${home_link}" ]]; then
            ln -sfn "${target}" "${home_link}"
        fi
    done
}

run_init_workspace() {
    if [[ ! -x "${WORKSPACE_SCRIPT}" ]]; then
        return 0
    fi
    "${WORKSPACE_SCRIPT}" || true
}

enter_project_dir() {
    if [[ -z "${PROJECT_DIR:-}" ]]; then
        printf 'Error: PROJECT_DIR is not set inside the container\n' >&2
        printf 'Hint: run make env on the host and restart the container\n' >&2
        exit 1
    fi

    create_project_symlinks

    if [[ -n "${WORKSPACE_ROOT:-}" && -d "${WORKSPACE_ROOT}" ]]; then
        cd "${WORKSPACE_ROOT}"
        return 0
    fi

    if [[ ! -d "${PROJECT_DIR}" ]]; then
        printf 'Error: PROJECT_DIR does not exist in the container: %s\n' "${PROJECT_DIR}" >&2
        exit 1
    fi

    cd "${PROJECT_DIR}"
}

run_init() {
    # Cursor home seeds only matter when the Cursor CLI is in the image.
    if [[ "${ORCAN_VARIANT}" == "claude" ]] && ! command -v agent >/dev/null 2>&1; then
        return 0
    fi
    if [[ ! -x "${INIT_SCRIPT}" ]]; then
        printf 'Warning: init script not found or not executable: %s\n' "${INIT_SCRIPT}" >&2
        return 0
    fi
    "${INIT_SCRIPT}"
}

run_init_claude_home() {
    # Claude Code is present in every variant (full and claude-only).
    if [[ ! -x "${INIT_CLAUDE_HOME_SCRIPT}" ]]; then
        return 0
    fi
    "${INIT_CLAUDE_HOME_SCRIPT}" || true
}

run_init_ai_statusline() {
    if [[ ! -x "${AI_STATUSLINE_SCRIPT}" ]]; then
        return 0
    fi
    "${AI_STATUSLINE_SCRIPT}" || true
}

ensure_shell_home() {
    # Seed bashrc.d / zshrc.d from skel; drop legacy cursor-dev names.
    # Always refresh managed PATH/cwd/user-overlay snippets so image logic stays in sync.
    local src dst base
    local dotfiles="${ORCAN_DOTFILES:-${HOME}/.config/orcan/dotfiles}"
    mkdir -p "${HOME}/.bashrc.d" "${HOME}/.zshrc.d" "${HOME}/.cache/zsh" "${HOME}/.config"
    mkdir -p \
        "${HOME}/.cache/ruff" \
        "${HOME}/.cache/mypy" \
        "${HOME}/.cache/pip" \
        "${HOME}/.cache/uv" \
        "${HOME}/.cache/pre-commit" \
        "${HOME}/.cache/yarn" \
        "${HOME}/.cache/go-build" \
        "${HOME}/.cache/turbo"

    rm -f "${HOME}/.bashrc.d/50-cursor-dev.sh" \
        "${HOME}/.bashrc.d/50-cind-shell.sh" \
        "${HOME}/.zshrc.d/50-cind-shell.zsh"
    for src in /etc/skel/.bashrc.d/*.sh; do
        [[ -f "${src}" ]] || continue
        dst="${HOME}/.bashrc.d/$(basename "${src}")"
        base="$(basename "${src}")"
        if [[ "${base}" == "50-orcan-shell.sh" \
            || "${base}" == "55-orcan-devtools.sh" \
            || "${base}" == "65-orcan-user.sh" \
            || ! -e "${dst}" ]]; then
            cp -- "${src}" "${dst}"
        fi
    done

    if [[ -f /etc/skel/.zshrc && ! -e "${HOME}/.zshrc" ]]; then
        cp -- /etc/skel/.zshrc "${HOME}/.zshrc"
    fi
    for src in /etc/skel/.zshrc.d/*.zsh; do
        [[ -f "${src}" ]] || continue
        dst="${HOME}/.zshrc.d/$(basename "${src}")"
        base="$(basename "${src}")"
        if [[ "${base}" == "50-orcan-shell.zsh" \
            || "${base}" == "55-orcan-devtools.zsh" \
            || "${base}" == "65-orcan-user.zsh" \
            || ! -e "${dst}" ]]; then
            cp -- "${src}" "${dst}"
        fi
    done

    # Managed: always refresh so new image hooks (dotfiles) apply.
    if [[ -f /etc/skel/.tmux.conf ]]; then
        cp -- /etc/skel/.tmux.conf "${HOME}/.tmux.conf"
    fi
    if [[ -f /etc/skel/.vimrc ]]; then
        cp -- /etc/skel/.vimrc "${HOME}/.vimrc"
    fi
    mkdir -p "${HOME}/.config"
    if [[ -L "${HOME}/.config/tmux" || ! -e "${HOME}/.config/tmux" ]]; then
        ln -sfn /etc/tmux "${HOME}/.config/tmux"
    fi

    if [[ -f "${dotfiles}/starship.toml" ]]; then
        mkdir -p "${HOME}/.config"
        ln -sfn "${dotfiles}/starship.toml" "${HOME}/.config/starship.toml"
    elif [[ -f /opt/orcan/starship.toml && ! -e "${HOME}/.config/starship.toml" ]]; then
        cp -- /opt/orcan/starship.toml "${HOME}/.config/starship.toml"
    fi
    if [[ -f /opt/orcan/gitconfig && ! -e "${HOME}/.gitconfig" ]]; then
        cp -- /opt/orcan/gitconfig "${HOME}/.gitconfig"
    fi

    # Apply host identity from Compose env (orcan sync). GIT_AUTHOR_* alone is
    # enough for commits; user.* keeps tools that only read gitconfig consistent.
    if command -v git >/dev/null 2>&1; then
        if [[ -n "${GIT_AUTHOR_NAME:-}" ]]; then
            git config --global user.name "${GIT_AUTHOR_NAME}" || true
        fi
        if [[ -n "${GIT_AUTHOR_EMAIL:-}" ]]; then
            git config --global user.email "${GIT_AUTHOR_EMAIL}" || true
        fi
        if [[ -f "${dotfiles}/gitconfig.local" ]]; then
            git config --global include.path "${dotfiles}/gitconfig.local" || true
        fi
    fi

    # Parent for optional known_hosts bind (compose-git overlay).
    mkdir -p "${HOME}/.ssh"
    chmod 700 "${HOME}/.ssh" 2>/dev/null || true

    if [[ -f "${HOME}/.profile" ]]; then
        if grep -q 'cursor-dev-path\|cind-path' "${HOME}/.profile" 2>/dev/null; then
            sed -i \
                -e 's|/etc/profile.d/cursor-dev-path.sh|/etc/profile.d/orcan-path.sh|g' \
                -e 's|/etc/profile.d/cind-path.sh|/etc/profile.d/orcan-path.sh|g' \
                "${HOME}/.profile" || true
        fi
    fi
}

main() {
    fix_named_volume_permissions
    persist_claude_config
    run_init
    run_init_claude_home
    run_init_ai_statusline
    ensure_shell_home
    run_init_workspace
    enter_project_dir

    if [[ -f /etc/orcan/shell/devtools-env.sh ]]; then
        set -a
        # shellcheck disable=SC1091
        # shellcheck source=/etc/orcan/shell/devtools-env.sh
        . /etc/orcan/shell/devtools-env.sh
        set +a
    fi

    if [[ "$#" -eq 0 ]]; then
        set -- zsh
    fi

    exec "$@"
}

main "$@"
