#!/usr/bin/env bash
# Container entrypoint: initialize Cursor home defaults, then exec CMD.

set -Eeuo pipefail

INIT_SCRIPT="${INIT_CURSOR_HOME_SCRIPT:-/usr/local/bin/init-cursor-home}"
AI_STATUSLINE_SCRIPT="${INIT_AI_STATUSLINE_SCRIPT:-/usr/local/bin/init-ai-statusline}"
WORKSPACE_SCRIPT="${INIT_WORKSPACE_SCRIPT:-/usr/local/bin/init-workspace}"

fix_named_volume_permissions() {
    local dir uid gid

    uid="$(id -u)"
    gid="$(id -g)"

    for dir in \
        "${HOME}/.config/cursor" \
        "${HOME}/.cursor"
    do
        [[ -e "${dir}" ]] || continue
        if [[ "$(stat -c '%u' "${dir}")" != "${uid}" ]] \
            || [[ ! -w "${dir}" ]] \
            || find "${dir}" ! -user "${uid}" -print -quit 2>/dev/null | grep -q .; then
            sudo chown -R "${uid}:${gid}" "${dir}"
        fi
    done
}

create_project_symlinks() {
    if [[ -z "${PROJECT_DIR:-}" ]]; then
        return 0
    fi

    local home_link current
    for home_link in "${HOME}/project" "${HOME}/workspace"; do
        if [[ -n "${WORKSPACE_ROOT:-}" && -d "${WORKSPACE_ROOT}" ]]; then
            target="${WORKSPACE_ROOT}"
        else
            target="${PROJECT_DIR}"
        fi
        if [[ -L "${home_link}" ]]; then
            current="$(readlink "${home_link}")"
            if [[ "${current}" != "${target}" ]]; then
                ln -sfn "${target}" "${home_link}"
            fi
        elif [[ ! -e "${home_link}" ]]; then
            ln -sfn "${target}" "${home_link}"
        fi
    done
}

run_init_workspace() {
    if [[ ! -x "${WORKSPACE_SCRIPT}" ]]; then
        return 0
    fi
    "${WORKSPACE_SCRIPT}" || true
}

enter_project_dir() {
    if [[ -z "${PROJECT_DIR:-}" ]]; then
        printf 'Error: PROJECT_DIR is not set inside the container\n' >&2
        printf 'Hint: run make env on the host and restart the container\n' >&2
        exit 1
    fi

    create_project_symlinks

    if [[ -n "${WORKSPACE_ROOT:-}" && -d "${WORKSPACE_ROOT}" ]]; then
        cd "${WORKSPACE_ROOT}"
        return 0
    fi

    if [[ ! -d "${PROJECT_DIR}" ]]; then
        printf 'Error: PROJECT_DIR does not exist in the container: %s\n' "${PROJECT_DIR}" >&2
        exit 1
    fi

    cd "${PROJECT_DIR}"
}

run_init() {
    if [[ ! -x "${INIT_SCRIPT}" ]]; then
        printf 'Warning: init script not found or not executable: %s\n' "${INIT_SCRIPT}" >&2
        return 0
    fi
    "${INIT_SCRIPT}"
}

run_init_ai_statusline() {
    if [[ ! -x "${AI_STATUSLINE_SCRIPT}" ]]; then
        return 0
    fi
    "${AI_STATUSLINE_SCRIPT}" || true
}

ensure_shell_home() {
    # Seed bashrc.d / zshrc.d from skel; drop legacy cursor-dev names.
    # Always refresh managed PATH/cwd snippets so image logic stays in sync.
    local src dst base
    mkdir -p "${HOME}/.bashrc.d" "${HOME}/.zshrc.d" "${HOME}/.cache/zsh" "${HOME}/.config"

    rm -f "${HOME}/.bashrc.d/50-cursor-dev.sh"
    for src in /etc/skel/.bashrc.d/*.sh; do
        [[ -f "${src}" ]] || continue
        dst="${HOME}/.bashrc.d/$(basename "${src}")"
        base="$(basename "${src}")"
        if [[ "${base}" == "50-cind-shell.sh" || ! -e "${dst}" ]]; then
            cp -- "${src}" "${dst}"
        fi
    done

    if [[ -f /etc/skel/.zshrc && ! -e "${HOME}/.zshrc" ]]; then
        cp -- /etc/skel/.zshrc "${HOME}/.zshrc"
    fi
    for src in /etc/skel/.zshrc.d/*.zsh; do
        [[ -f "${src}" ]] || continue
        dst="${HOME}/.zshrc.d/$(basename "${src}")"
        base="$(basename "${src}")"
        if [[ "${base}" == "50-cind-shell.zsh" || ! -e "${dst}" ]]; then
            cp -- "${src}" "${dst}"
        fi
    done

    if [[ -f /opt/cind/starship.toml && ! -e "${HOME}/.config/starship.toml" ]]; then
        cp -- /opt/cind/starship.toml "${HOME}/.config/starship.toml"
    fi
    if [[ -f /opt/cind/gitconfig && ! -e "${HOME}/.gitconfig" ]]; then
        cp -- /opt/cind/gitconfig "${HOME}/.gitconfig"
    fi

    if [[ -f "${HOME}/.profile" ]] && grep -q 'cursor-dev-path' "${HOME}/.profile" 2>/dev/null; then
        sed -i 's|/etc/profile.d/cursor-dev-path.sh|/etc/profile.d/cind-path.sh|g' "${HOME}/.profile" || true
    fi
}

main() {
    fix_named_volume_permissions
    run_init
    run_init_ai_statusline
    ensure_shell_home
    run_init_workspace
    enter_project_dir

    if [[ "$#" -eq 0 ]]; then
        set -- zsh
    fi

    exec "$@"
}

main "$@"
