#!/usr/bin/env bash
# Attach to a workspace tmux session — default tabs tab-1, tab-2, …
# Usage: cursor-tmux-workspace-attach SESSION WORKSPACE_ROOT [WORKSPACE_LABEL]
set -Eeuo pipefail

SESSION="${1:-}"
WORKSPACE_ROOT="${2:-}"
WORKSPACE_LABEL="${3:-}"
ORCAN_CONFIG="${ORCAN_CONFIG:-/etc/orcan/config.json}"

if [[ -z "${SESSION}" || -z "${WORKSPACE_ROOT}" ]]; then
    echo "Usage: cursor-tmux-workspace-attach SESSION WORKSPACE_ROOT [LABEL]" >&2
    exit 1
fi

if [[ ! -d "${WORKSPACE_ROOT}" ]]; then
    echo "Workspace root does not exist: ${WORKSPACE_ROOT}" >&2
    echo "Hint: init-workspace runs at container startup; check orcan.config.json" >&2
    exit 1
fi

WORKSPACE_ROOT="$(cd -- "${WORKSPACE_ROOT}" && pwd)"
WORKSPACE_LABEL="${WORKSPACE_LABEL:-$(basename "${WORKSPACE_ROOT}")}"

# shellcheck source=/etc/orcan/shell/workspace-history.sh
. /etc/orcan/shell/workspace-history.sh
WORKSPACE_HISTFILE="$(orcan_workspace_histfile_path "${WORKSPACE_LABEL}" zsh)"
mkdir -p "$(dirname "${WORKSPACE_HISTFILE}")" 2>/dev/null || true

sanitize_session_name() {
    local name="$1"
    name="$(printf '%s' "${name}" | tr -c 'A-Za-z0-9_-' '_')"
    name="${name##_}"
    name="${name%%_}"
    [[ -n "${name}" ]] || name="workspace"
    printf '%s\n' "${name:0:50}"
}

SESSION="$(sanitize_session_name "${SESSION}")"
TMUX_CONF="${TMUX_CONF:-${HOME}/.tmux.conf}"
mkdir -p "${HOME}/.cache/tmux" 2>/dev/null || true

tmux_cmd() {
    tmux -f "${TMUX_CONF}" "$@"
}

# Keep ORCAN_* out of the tmux *global* environment so session A does not
# leak into session B's first pane / bashrc.
clear_global_orcan_env() {
    tmux_cmd set-environment -gu ORCAN_WORKSPACE_NAME 2>/dev/null || true
    tmux_cmd set-environment -gu ORCAN_WORKSPACE_ROOT 2>/dev/null || true
    tmux_cmd set-environment -gu ORCAN_PROJECT_NAME 2>/dev/null || true
    tmux_cmd set-environment -gu ORCAN_PROJECT_PATH 2>/dev/null || true
    tmux_cmd set-environment -gu HISTFILE 2>/dev/null || true
}

set_session_env() {
    tmux_cmd set-environment -t "=${SESSION}" ORCAN_WORKSPACE_NAME "${WORKSPACE_LABEL}"
    tmux_cmd set-environment -t "=${SESSION}" ORCAN_WORKSPACE_ROOT "${WORKSPACE_ROOT}"
    tmux_cmd set-environment -t "=${SESSION}" ORCAN_PROJECT_NAME "${WORKSPACE_LABEL}"
    tmux_cmd set-environment -t "=${SESSION}" ORCAN_PROJECT_PATH "${WORKSPACE_ROOT}"
    tmux_cmd set-environment -t "=${SESSION}" HISTFILE "${WORKSPACE_HISTFILE}"
    tmux_cmd set -g mouse on 2>/dev/null || true
    clear_global_orcan_env
}

session_root_ok() {
    local got
    got="$(tmux_cmd show-environment -t "=${SESSION}" ORCAN_WORKSPACE_ROOT 2>/dev/null || true)"
    [[ "${got}" == "ORCAN_WORKSPACE_ROOT=${WORKSPACE_ROOT}" ]]
}

read_tab_defaults() {
    INITIAL_WINDOWS=3
    WINDOW_PREFIX="tab"
    [[ -f "${ORCAN_CONFIG}" ]] || return 0
    while IFS=$'\t' read -r count prefix; do
        [[ -n "${count}" ]] && INITIAL_WINDOWS="${count}"
        [[ -n "${prefix}" ]] && WINDOW_PREFIX="${prefix}"
    done < <(python3 - "${ORCAN_CONFIG}" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as fh:
    cfg = json.load(fh)
tmux = cfg.get("tmux") if isinstance(cfg.get("tmux"), dict) else {}
count = int(tmux.get("initial_windows", 3))
prefix = str(tmux.get("window_prefix") or "tab").strip() or "tab"
if count < 1:
    count = 1
if count > 9:
    count = 9
print(f"{count}\t{prefix}")
PY
)
}

bootstrap_session() {
    local i title

    read_tab_defaults
    clear_global_orcan_env

    # -e sets session env *before* the first pane's shell starts (bashrc).
    tmux_cmd new-session -d -s "${SESSION}" -c "${WORKSPACE_ROOT}" \
        -e "ORCAN_WORKSPACE_NAME=${WORKSPACE_LABEL}" \
        -e "ORCAN_WORKSPACE_ROOT=${WORKSPACE_ROOT}" \
        -e "ORCAN_PROJECT_NAME=${WORKSPACE_LABEL}" \
        -e "ORCAN_PROJECT_PATH=${WORKSPACE_ROOT}" \
        -e "HISTFILE=${WORKSPACE_HISTFILE}" \
        -n "${WINDOW_PREFIX}-1"
    set_session_env

    for (( i=2; i<=INITIAL_WINDOWS; i++ )); do
        title="${WINDOW_PREFIX}-${i}"
        tmux_cmd new-window -t "=${SESSION}" -n "${title}" -c "${WORKSPACE_ROOT}"
    done

    tmux_cmd select-window -t "=${SESSION}:1"
}

ensure_session() {
    if tmux_cmd has-session -t "=${SESSION}" 2>/dev/null; then
        if session_root_ok; then
            set_session_env
            return 0
        fi
        # Stale session (wrong root from an earlier bug / bootstrap order).
        tmux_cmd kill-session -t "=${SESSION}" 2>/dev/null || true
    fi
    bootstrap_session
}

ensure_session
cd "${WORKSPACE_ROOT}"
if [[ "${ORCAN_TMUX_ATTACH:-1}" == "0" ]]; then
    exit 0
fi
exec tmux -f "${TMUX_CONF}" attach -t "=${SESSION}"
