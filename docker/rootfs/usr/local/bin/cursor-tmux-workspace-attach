#!/usr/bin/env bash
# Attach to a workspace tmux session — default tabs workspace-1, workspace-2, …
# Usage: cursor-tmux-workspace-attach SESSION WORKSPACE_ROOT [WORKSPACE_LABEL]
set -Eeuo pipefail

SESSION="${1:-}"
WORKSPACE_ROOT="${2:-}"
WORKSPACE_LABEL="${3:-}"
CIND_CONFIG="${CIND_CONFIG:-/etc/cind/config.json}"

if [[ -z "${SESSION}" || -z "${WORKSPACE_ROOT}" ]]; then
    echo "Usage: cursor-tmux-workspace-attach SESSION WORKSPACE_ROOT [LABEL]" >&2
    exit 1
fi

if [[ ! -d "${WORKSPACE_ROOT}" ]]; then
    echo "Workspace root does not exist: ${WORKSPACE_ROOT}" >&2
    echo "Hint: init-workspace runs at container startup; check cind.config.json" >&2
    exit 1
fi

WORKSPACE_ROOT="$(cd -- "${WORKSPACE_ROOT}" && pwd -P)"
WORKSPACE_LABEL="${WORKSPACE_LABEL:-$(basename "${WORKSPACE_ROOT}")}"

export CIND_WORKSPACE_NAME="${WORKSPACE_LABEL}"
export CIND_WORKSPACE_ROOT="${WORKSPACE_ROOT}"

sanitize_session_name() {
    local name="$1"
    name="$(printf '%s' "${name}" | tr -c 'A-Za-z0-9_-' '_')"
    name="${name##_}"
    name="${name%%_}"
    [[ -n "${name}" ]] || name="workspace"
    printf '%s\n' "${name:0:50}"
}

SESSION="$(sanitize_session_name "${SESSION}")"
TMUX_CONF="${TMUX_CONF:-${HOME}/.tmux.conf}"
mkdir -p "${HOME}/.cache/tmux" 2>/dev/null || true

tmux_cmd() {
    tmux -f "${TMUX_CONF}" "$@"
}

set_session_env() {
    tmux_cmd set-environment -t "=${SESSION}" CIND_WORKSPACE_NAME "${WORKSPACE_LABEL}" 2>/dev/null || true
    tmux_cmd set-environment -t "=${SESSION}" CIND_WORKSPACE_ROOT "${WORKSPACE_ROOT}" 2>/dev/null || true
    tmux_cmd set-environment -t "=${SESSION}" CIND_PROJECT_NAME "${WORKSPACE_LABEL}" 2>/dev/null || true
    tmux_cmd set-environment -t "=${SESSION}" CIND_PROJECT_PATH "${WORKSPACE_ROOT}" 2>/dev/null || true
    tmux_cmd set -g mouse on 2>/dev/null || true
}

read_tab_defaults() {
    INITIAL_WINDOWS=3
    WINDOW_PREFIX="workspace"
    [[ -f "${CIND_CONFIG}" ]] || return 0
    while IFS=$'\t' read -r count prefix; do
        [[ -n "${count}" ]] && INITIAL_WINDOWS="${count}"
        [[ -n "${prefix}" ]] && WINDOW_PREFIX="${prefix}"
    done < <(python3 - "${CIND_CONFIG}" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as fh:
    cfg = json.load(fh)
tmux = cfg.get("tmux") if isinstance(cfg.get("tmux"), dict) else {}
count = int(tmux.get("initial_windows", 3))
prefix = str(tmux.get("window_prefix") or "workspace").strip() or "workspace"
if count < 1:
    count = 1
if count > 9:
    count = 9
print(f"{count}\t{prefix}")
PY
)
}

bootstrap_session() {
    local i title

    read_tab_defaults

    tmux_cmd new-session -d -s "${SESSION}" -c "${WORKSPACE_ROOT}" \
        -n "${WINDOW_PREFIX}-1"
    set_session_env

    for (( i=2; i<=INITIAL_WINDOWS; i++ )); do
        title="${WINDOW_PREFIX}-${i}"
        tmux_cmd new-window -t "=${SESSION}" -n "${title}" -c "${WORKSPACE_ROOT}"
    done

    tmux_cmd select-window -t "=${SESSION}:1"
}

if tmux_cmd has-session -t "=${SESSION}" 2>/dev/null; then
    set_session_env
    cd "${WORKSPACE_ROOT}"
    if [[ "${CIND_TMUX_ATTACH:-1}" == "0" ]]; then
        exit 0
    fi
    exec tmux -f "${TMUX_CONF}" attach -t "=${SESSION}"
fi

bootstrap_session
cd "${WORKSPACE_ROOT}"
if [[ "${CIND_TMUX_ATTACH:-1}" == "0" ]]; then
    exit 0
fi
exec tmux -f "${TMUX_CONF}" attach -t "=${SESSION}"
