#!/usr/bin/env bash
# Attach to a workspace tmux session — workspace tab + project tabs (optional windows[]).
# Usage: cursor-tmux-workspace-attach SESSION WORKSPACE_ROOT [WORKSPACE_LABEL]
set -Eeuo pipefail

SESSION="${1:-}"
WORKSPACE_ROOT="${2:-}"
WORKSPACE_LABEL="${3:-}"
CIND_CONFIG="${CIND_CONFIG:-/etc/cind/config.json}"

if [[ -z "${SESSION}" || -z "${WORKSPACE_ROOT}" ]]; then
    echo "Usage: cursor-tmux-workspace-attach SESSION WORKSPACE_ROOT [LABEL]" >&2
    exit 1
fi

if [[ ! -d "${WORKSPACE_ROOT}" ]]; then
    echo "Workspace root does not exist: ${WORKSPACE_ROOT}" >&2
    echo "Hint: init-workspace runs at container startup; check cind.config.json" >&2
    exit 1
fi

WORKSPACE_ROOT="$(cd -- "${WORKSPACE_ROOT}" && pwd -P)"
WORKSPACE_LABEL="${WORKSPACE_LABEL:-$(basename "${WORKSPACE_ROOT}")}"

export CIND_WORKSPACE_NAME="${WORKSPACE_LABEL}"
export CIND_WORKSPACE_ROOT="${WORKSPACE_ROOT}"

sanitize_session_name() {
    local name="$1"
    name="$(printf '%s' "${name}" | tr -c 'A-Za-z0-9_-' '_')"
    name="${name##_}"
    name="${name%%_}"
    [[ -n "${name}" ]] || name="workspace"
    printf '%s\n' "${name:0:50}"
}

SESSION="$(sanitize_session_name "${SESSION}")"
TMUX_CONF="${TMUX_CONF:-${HOME}/.tmux.conf}"
mkdir -p "${HOME}/.cache/tmux" 2>/dev/null || true

tmux_cmd() {
    tmux -f "${TMUX_CONF}" "$@"
}

set_session_env() {
    tmux_cmd set-environment -t "=${SESSION}" CIND_WORKSPACE_NAME "${WORKSPACE_LABEL}" 2>/dev/null || true
    tmux_cmd set-environment -t "=${SESSION}" CIND_WORKSPACE_ROOT "${WORKSPACE_ROOT}" 2>/dev/null || true
    tmux_cmd set-environment -t "=${SESSION}" CIND_PROJECT_NAME "${WORKSPACE_LABEL}" 2>/dev/null || true
    tmux_cmd set-environment -t "=${SESSION}" CIND_PROJECT_PATH "${WORKSPACE_ROOT}" 2>/dev/null || true
}

fetch_workspace_layout() {
    [[ -f "${CIND_CONFIG}" ]] || return 1
    python3 - "${CIND_CONFIG}" "${WORKSPACE_LABEL}" "${WORKSPACE_ROOT}" <<'PY'
import json
import sys
from pathlib import Path

config_path, workspace_name, workspace_root = sys.argv[1:4]


def repo_icon(name: str) -> str:
    key = (name or "").strip().lower()
    icons = {
        "backend": "🐍",
        "api": "🐍",
        "server": "🐍",
        "frontend": "🌐",
        "web": "🌐",
        "ui": "🌐",
        "agent": "🤖",
        "orchestrator": "🤖",
        "docs": "📖",
        "doc": "📖",
        "infra": "⚙",
        "devops": "⚙",
        "ops": "⚙",
        "shared": "🧩",
        "common": "🧩",
        "lib": "🧩",
        "test": "🧪",
        "tests": "🧪",
        "database": "🗄",
        "db": "🗄",
    }
    return icons.get(key, "📁")


def resolve_dir(base: str, rel: str) -> str:
    rel = (rel or ".").strip()
    base_path = Path(base)
    if rel == "." or not rel:
        return str(base_path)
    if rel.startswith("/"):
        return rel
    return str((base_path / rel).resolve())


def emit(title: str, cwd: str, command: str = "") -> None:
    print(f"{title}\t{cwd}\t{command}")


emit("🖥 workspace", workspace_root)

with open(config_path, encoding="utf-8") as fh:
    cfg = json.load(fh)

projects = []
workspaces = cfg.get("workspaces") or []
if workspaces:
    for ws in workspaces:
        if ws.get("name") == workspace_name:
            projects = ws.get("projects") or []
            break
    if not projects and len(workspaces) == 1:
        projects = workspaces[0].get("projects") or []
else:
    legacy = cfg.get("workspace") or {}
    if legacy.get("name", workspace_name) == workspace_name or not workspace_name:
        projects = legacy.get("projects") or cfg.get("projects") or []

if not projects:
    raise SystemExit(1)

for item in projects:
    name = (item.get("name") or "").strip()
    project_cwd = (
        (item.get("container_path") or item.get("workspace_path") or item.get("path") or "")
        .strip()
    )
    if not name or not project_cwd:
        continue

    windows = item.get("windows") or []
    project_icon = repo_icon(name)

    if windows:
        for win in windows:
            win_name = (win.get("name") or "shell").strip()
            win_icon = (win.get("icon") or "").strip()
            suffix = f"{win_icon} {win_name}".strip() if win_icon else win_name
            title = f"{project_icon} {name} · {suffix}"
            cwd = resolve_dir(project_cwd, win.get("dir") or ".")
            command = (win.get("command") or "").strip()
            emit(title, cwd, command)
    else:
        emit(f"{project_icon} {name}", project_cwd)
PY
}

first_window_target() {
    local idx
    idx="$(tmux_cmd list-windows -t "=${SESSION}" -F '#{window_index}' 2>/dev/null | sort -n | head -1)"
    [[ -n "${idx}" ]] || idx="0"
    printf '=%s:%s\n' "${SESSION}" "${idx}"
}

create_window() {
    local index="$1"
    local title="$2"
    local dir="$3"
    local command="$4"
    local target

    mkdir -p "${dir}" 2>/dev/null || true

    if (( index == 1 )); then
        target="$(first_window_target)"
        tmux_cmd rename-window -t "${target}" "${title}"
        if [[ "${dir}" != "${WORKSPACE_ROOT}" ]]; then
            tmux_cmd send-keys -t "${target}" "cd -- $(printf '%q' "${dir}")" C-m || true
        fi
    else
        tmux_cmd new-window -t "=${SESSION}" -n "${title}" -c "${dir}"
        target="=${SESSION}:${title}"
    fi

    if [[ -n "${command}" && "${command}" != "bash" ]]; then
        tmux_cmd send-keys -t "${target}" "${command}" C-m || true
    fi
}

bootstrap_session() {
    local line title dir command index=1
    local layout_file="${HOME}/.cache/tmux/bootstrap.${SESSION}.lst"

    if ! fetch_workspace_layout >"${layout_file}" 2>/dev/null; then
        echo "No projects in config for workspace session" >&2
        exit 1
    fi

    tmux_cmd new-session -d -s "${SESSION}" -c "${WORKSPACE_ROOT}" -n "🖥 workspace"
    set_session_env

    while IFS=$'\t' read -r title dir command; do
        [[ -n "${title}" && -n "${dir}" ]] || continue
        create_window "${index}" "${title}" "${dir}" "${command:-}"
        index=$((index + 1))
    done <"${layout_file}"

    rm -f "${layout_file}"
    tmux_cmd select-window -t "$(first_window_target)"
}

if tmux_cmd has-session -t "=${SESSION}" 2>/dev/null; then
    set_session_env
    cd "${WORKSPACE_ROOT}"
    if [[ "${CIND_TMUX_ATTACH:-1}" == "0" ]]; then
        exit 0
    fi
    exec tmux -f "${TMUX_CONF}" attach -t "=${SESSION}"
fi

bootstrap_session
cd "${WORKSPACE_ROOT}"
if [[ "${CIND_TMUX_ATTACH:-1}" == "0" ]]; then
    exit 0
fi
exec tmux -f "${TMUX_CONF}" attach -t "=${SESSION}"
