#!/usr/bin/env python3
"""Cascading session recap for Context Assertions.

One batch (~N user turns) → compact → merge with rolling recap → on topic drift
flush mature recap to context-inbox. Invoked by ``orcan-context-scan``; shares
``.orcan/reflection-state.json`` offsets with the Claude Stop hook.

  orcan-context-recap --agent claude|cursor --session-id ID \\
      --transcript-path PATH --cwd CWD
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from orcan.recap import process_one_batch  # noqa: E402
from orcan.session_scan import SessionRef  # noqa: E402
from orcan.workspaces import iter_workspaces, load_config  # noqa: E402

PROPOSE_BIN = Path(__file__).resolve().parent / "orcan-context-propose"


def warn(msg: str) -> None:
    print(f"orcan-context-recap: {msg}", file=sys.stderr)


def resolve_workspace_root(cwd: str) -> Path | None:
    import os

    raw = cwd or os.environ.get("ORCAN_WORKSPACE_ROOT") or str(Path.cwd())
    root = Path(raw)
    if not root.is_dir():
        return None
    return root.resolve()


def find_current_workspace(root: Path) -> dict | None:
    try:
        cfg = load_config(None)
    except (OSError, ValueError, json.JSONDecodeError):
        return None
    for ws in iter_workspaces(cfg):
        if ws["root"] and Path(ws["root"]).resolve() == root:
            return ws
    return None


def infer_project(ws: dict, cwd: str) -> str | None:
    projects = [p for p in (ws.get("projects") or []) if isinstance(p, dict) and p.get("name")]
    if not cwd:
        return projects[0]["name"] if len(projects) == 1 else None
    cwd_path = str(Path(cwd).resolve())
    for p in projects:
        for key in ("workspace_path", "path"):
            anchor = p.get(key)
            if anchor and (cwd_path == anchor or cwd_path.startswith(anchor.rstrip("/") + "/")):
                return str(p["name"])
    return projects[0]["name"] if len(projects) == 1 else None


def current_branch(project_path: Path) -> str:
    if not project_path.is_dir():
        return ""
    r = subprocess.run(
        ["git", "-C", str(project_path), "branch", "--show-current"],
        capture_output=True,
        text=True,
        check=False,
    )
    if r.returncode != 0:
        return ""
    return r.stdout.strip()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--agent", required=True, choices=("claude", "cursor"))
    parser.add_argument("--session-id", required=True, help="Bare session id (not state_key)")
    parser.add_argument("--transcript-path", required=True)
    parser.add_argument("--cwd", default="")
    parser.add_argument("--threshold", type=int, default=20)
    parser.add_argument("--model", default="haiku")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument(
        "--flush",
        action="store_true",
        help="Process remaining turns (< threshold) and flush rolling compact when caught up",
    )
    args = parser.parse_args()

    workspace_root = resolve_workspace_root(args.cwd)
    if workspace_root is None:
        warn("workspace root not found — skipping")
        return 0

    ws = find_current_workspace(workspace_root)
    if ws is None:
        warn("workspace not in config — skipping")
        return 0
    project = infer_project(ws, args.cwd)
    if project is None:
        warn("could not infer project — skipping")
        return 0
    project_path = next(
        (p.get("path") for p in ws.get("projects") or [] if p.get("name") == project),
        "",
    )
    branch = current_branch(Path(project_path)) if project_path else ""

    session = SessionRef(
        agent=args.agent,
        session_id=args.session_id,
        transcript_path=Path(args.transcript_path),
        cwd=args.cwd or str(workspace_root),
    )

    queued, _worked = process_one_batch(
        session,
        workspace_root,
        project=project,
        branch=branch,
        threshold=args.threshold,
        model=args.model,
        dry_run=args.dry_run,
        flush_remaining=args.flush,
        propose_bin=PROPOSE_BIN,
        log=lambda msg: print(f"orcan-context-recap: {msg}"),
    )
    if queued:
        print(f"orcan-context-recap: queued {queued} candidate(s) for review")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
