#!/usr/bin/env bash
# reconcile_sessions(workspaces): ensure a tmux session per configured
# workspace (idempotent — see cursor-tmux-workspace-attach's ensure_session).
#
# The single mechanism behind BOTH:
#   - container boot / first ttyd connect (cursor-tmux-bootstrap-workspaces)
#   - on-demand runtime modification (orcan-runtime-reconcile)
#
# Orphaned sessions (tmux sessions tagged orcan-managed whose workspace is no
# longer in config) are reported, never auto-killed — an active agent inside
# one must not lose its session just because the workspace it started in was
# renamed or removed. Pass --prune-orphans to opt into killing them (only
# ever explicit, never the default reconcile path).
set -Eeuo pipefail

ORCAN_CONFIG="${ORCAN_CONFIG:-/etc/orcan/config.json}"
TMUX_CONF="${TMUX_CONF:-${HOME}/.tmux.conf}"
PRUNE_ORPHANS=0

for arg in "$@"; do
    case "${arg}" in
        --prune-orphans) PRUNE_ORPHANS=1 ;;
        *) echo "Usage: orcan-tmux-reconcile-sessions [--prune-orphans]" >&2; exit 1 ;;
    esac
done

[[ -f "${ORCAN_CONFIG}" ]] || exit 0
command -v orcan-workspaces >/dev/null 2>&1 || exit 0

declare -a ACTIVE_SESSIONS=()
bootstrap="$(ORCAN_CONFIG="${ORCAN_CONFIG}" orcan-workspaces bootstrap)" || exit $?
reconcile_status=0

while IFS=$'\t' read -r name root session; do
    [[ -n "${name}" && -n "${root}" && -n "${session}" ]] || continue
    ACTIVE_SESSIONS+=("${session}")
    if [[ ! -d "${root}" ]]; then
        printf 'workspace root unavailable: %s\n' "${root}" >&2
        reconcile_status=1
        continue
    fi
    if ! ORCAN_TMUX_ATTACH=0 cursor-tmux-workspace-attach "${session}" "${root}" "${name}" >/dev/null; then
        printf 'could not reconcile tmux session: %s\n' "${session}" >&2
        reconcile_status=1
    fi
done <<<"${bootstrap}"

# Never prune against a partial workspace/session list.
(( reconcile_status == 0 )) || exit "${reconcile_status}"

# Orcan-managed sessions left over after a workspace was renamed/removed.
# Sessions without ORCAN_WORKSPACE_NAME are left alone (user or smoke
# sessions) — those are never ours to report or prune.
if command -v tmux >/dev/null 2>&1; then
    if live_sessions="$(LC_ALL=C tmux -f "${TMUX_CONF}" list-sessions -F '#{session_name}' 2>&1)"; then
        :
    else
        status=$?
        case "${live_sessions}" in
            "no server running on "*|"error connecting to "*"(No such file or directory)"|"failed to connect to server: No such file or directory")
                if (( ${#ACTIVE_SESSIONS[@]} == 0 )); then
                    # No configured sessions and no server is a clean empty state.
                    exit 0
                fi
                printf 'tmux server unavailable after reconciling configured sessions\n' >&2
                exit "${status}" ;;
        esac
        printf '%s\n' "${live_sessions}" | tail -n 20 >&2
        printf 'could not list tmux sessions; orphan inspection not completed\n' >&2
        exit "${status}"
    fi
    while IFS= read -r live; do
        [[ -n "${live}" ]] || continue
        keep=0
        for s in "${ACTIVE_SESSIONS[@]+"${ACTIVE_SESSIONS[@]}"}"; do
            if [[ "${live}" == "${s}" ]]; then
                keep=1
                break
            fi
        done
        if (( keep == 1 )); then
            continue
        fi
        if marker="$(LC_ALL=C tmux -f "${TMUX_CONF}" show-environment -t "=${live}" ORCAN_WORKSPACE_NAME 2>&1)"; then
            :
        else
            status=$?
            case "${marker}" in
                "unknown variable: ORCAN_WORKSPACE_NAME"|"can't find session: "*)
                    # An unmanaged or already exited session must not be pruned.
                    continue ;;
            esac
            printf '%s\n' "${marker}" | tail -n 20 >&2
            printf 'could not inspect tmux session ownership: %s\n' "${live}" >&2
            exit "${status}"
        fi
        if (( PRUNE_ORPHANS )); then
            if tmux -f "${TMUX_CONF}" kill-session -t "=${live}"; then
                printf 'removed orphaned orcan tmux session: %s\n' "${live}" >&2
            else
                status=$?
                printf 'could not remove orphaned orcan tmux session: %s\n' "${live}" >&2
                exit "${status}"
            fi
        else
            printf 'orphaned orcan tmux session (workspace no longer in config, not killed): %s\n' "${live}" >&2
        fi
    done <<<"${live_sessions}"
fi
