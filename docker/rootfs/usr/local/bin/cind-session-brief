#!/usr/bin/env bash
# Create .cind/session-brief.md in the current cind workspace (missing-only).
# Usage: cind-session-brief [workspace-root]
set -Eeuo pipefail

TEMPLATE="${CIND_SESSION_BRIEF_TEMPLATE:-/opt/cursor-defaults/templates/workspace/session-brief.md}"

usage() {
    cat <<'EOF'
Usage: cind-session-brief [workspace-root]

Create .cind/session-brief.md for agent/claude handoff (missing-only).

Default root: $CIND_WORKSPACE_ROOT, else current directory.
EOF
}

resolve_root() {
    local raw="${1:-}"
    if [[ -n "${raw}" ]]; then
        printf '%s\n' "$(cd -- "${raw}" && pwd -P)"
        return 0
    fi
    if [[ -n "${CIND_WORKSPACE_ROOT:-}" && -d "${CIND_WORKSPACE_ROOT}" ]]; then
        printf '%s\n' "$(cd -- "${CIND_WORKSPACE_ROOT}" && pwd -P)"
        return 0
    fi
    printf '%s\n' "$(pwd -P)"
}

main() {
    case "${1:-}" in
        -h|--help)
            usage
            exit 0
            ;;
    esac

    local root dest
    root="$(resolve_root "${1:-}")"
    dest="${root}/.cind/session-brief.md"

    if [[ ! -f "${TEMPLATE}" ]]; then
        printf 'Error: template missing: %s\n' "${TEMPLATE}" >&2
        exit 1
    fi

    if [[ -e "${dest}" ]]; then
        printf 'Exists: %s\n' "${dest}"
        printf 'Edit this file for handoff; agents read it when present.\n'
        exit 0
    fi

    mkdir -p "$(dirname "${dest}")"
    cp -- "${TEMPLATE}" "${dest}"
    printf 'Created: %s\n' "${dest}"
    printf 'Fill Goal / Constraints / Done / Next, then run agent or claude.\n'
}

main "$@"
