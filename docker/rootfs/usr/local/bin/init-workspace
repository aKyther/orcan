#!/usr/bin/env bash
# Thin entrypoint: build workspace trees (repo symlinks, manifests, agent
# instruction seeds) by calling the shared reconcile implementation.
# Runs once at container boot; `orcan-runtime-reconcile` calls the exact
# same Python function on demand, after a live config change.
set -Eeuo pipefail

ORCAN_CONFIG="${ORCAN_CONFIG:-/etc/orcan/config.json}"
DEFAULTS="${ORCAN_WORKSPACE_DEFAULTS:-/opt/cursor-defaults/templates/workspace}"

exec python3 - "${ORCAN_CONFIG}" "${DEFAULTS}" <<'PY'
import json
import sys
from pathlib import Path

sys.path.insert(0, "/usr/local/lib")
from orcan.reconcile import apply_workspaces  # noqa: E402

config_path, defaults_root = sys.argv[1:3]
with open(config_path, encoding="utf-8") as fh:
    cfg = json.load(fh)

report = apply_workspaces(cfg, Path(defaults_root))
for ws in report.workspaces:
    print(f"workspace ready: {ws.root} ({ws.repo_count} repo(s), tmux={ws.name})")
print(f"workspaces initialized: {len(report.workspaces)} ({report.total_repos()} repo mount(s) total)")
PY
