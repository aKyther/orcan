#!/usr/bin/env bash
# ttyd's PTY command (see cursor-ttyd) and `orcan enter` / `cursor-launcher`
# entry point.
#
# Thin shim into the orcan-cockpit console script — a real uv-managed
# Python project at ../../../../cockpit (repo root: cockpit/pyproject.toml),
# installed at build time into its own isolated venv via `uv sync`
# (Dockerfile), never the system Python. See cockpit/src/orcan_cockpit/cli.py
# for the interactive-vs-non-tty-fallback logic.

set -Eeuo pipefail

# Prefer a live checkout over the image-baked /opt/orcan-cockpit-src copy when
# PYTHONPATH is unset (preview bind-mount, sandbox editable install). Stale
# baked sources otherwise still expose pyte "brown" and crash Rich mid-render.
if [[ -z "${PYTHONPATH:-}" ]]; then
    shopt -s nullglob
    for _src in \
        /home/adam/.config/orcan/sandbox/orcan/cockpit/src \
        /home/developer/workspaces/*/orcan/cockpit/src; do
        if [[ -f "${_src}/orcan_cockpit/cli.py" ]]; then
            PYTHONPATH="${_src}:/usr/local/lib"
            export PYTHONPATH
            break
        fi
    done
    shopt -u nullglob
fi

exec /opt/orcan-cockpit/venv/bin/orcan-cockpit "$@"
