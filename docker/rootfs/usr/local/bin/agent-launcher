#!/usr/bin/env bash
# Workspace picker for ttyd — one tmux session per workspace.
# Phone-friendly: choose by number. Detach (prefix d) returns here.
# Compatibility: cursor-launcher → this script (symlink).

set -Eeuo pipefail

ORCAN_CONFIG="${ORCAN_CONFIG:-/etc/orcan/config.json}"
PROJECT_DIR="${PROJECT_DIR:-}"
LAST_WORKSPACE_FILE="${HOME}/.cache/orcan/last-workspace"
AUTO_REATTACH_SECS="${ORCAN_AUTO_REATTACH_SECS:-2}"

declare -a WS_NAMES=()
declare -a WS_ROOTS=()
declare -a WS_SESSIONS=()
declare -a WS_REPOS=()
declare -a WS_HINTS=()

save_last_workspace() {
    local session="$1" root="$2" label="$3"
    mkdir -p "$(dirname "${LAST_WORKSPACE_FILE}")"
    printf '%s\t%s\t%s\n' "${session}" "${root}" "${label}" > "${LAST_WORKSPACE_FILE}"
}

# Auto-reattach after ttyd WebSocket drops (new PTY → new launcher).
# Enter during countdown → menu. ORCAN_AUTO_REATTACH=0 disables.
try_auto_reattach() {
    local session root label secs
    [[ "${ORCAN_AUTO_REATTACH:-1}" != "0" ]] || return 1
    [[ -f "${LAST_WORKSPACE_FILE}" ]] || return 1

    IFS=$'\t' read -r session root label < "${LAST_WORKSPACE_FILE}" || return 1
    [[ -n "${session}" && -n "${root}" ]] || return 1
    label="${label:-${session}}"
    [[ -d "${root}" ]] || return 1
    tmux has-session -t "=${session}" 2>/dev/null || return 1

    secs="${AUTO_REATTACH_SECS}"
    [[ "${secs}" =~ ^[0-9]+$ ]] || secs=2
    if (( secs < 1 )); then
        secs=1
    fi

    clear 2>/dev/null || true
    printf 'Reconnecting to %s in %ss… (Enter = menu)\n' "${label}" "${secs}"
    if read -t "${secs}" -r _; then
        return 1
    fi

    printf 'Attaching session %s (%s)…\n' "${session}" "${label}"
    cursor-tmux-workspace-attach "${session}" "${root}" "${label}" || true
    return 0
}

load_workspaces() {
    WS_NAMES=()
    WS_ROOTS=()
    WS_SESSIONS=()
    WS_REPOS=()
    WS_HINTS=()

    [[ -f "${ORCAN_CONFIG}" ]] || return 1
    command -v orcan-workspaces >/dev/null 2>&1 || return 1

    while IFS=$'\t' read -r name root session repos hints; do
        [[ -n "${name}" ]] || continue
        WS_NAMES+=("${name}")
        WS_ROOTS+=("${root}")
        WS_SESSIONS+=("${session}")
        WS_REPOS+=("${repos}")
        WS_HINTS+=("${hints}")
    done < <(ORCAN_CONFIG="${ORCAN_CONFIG}" orcan-workspaces list --hints)

    ((${#WS_NAMES[@]} > 0))
}

workspace_status() {
    local session="$1"
    if tmux has-session -t "=${session}" 2>/dev/null; then
        printf '[tmux live]'
    else
        printf '[new]'
    fi
}

print_menu() {
    local i
    clear 2>/dev/null || true
    printf 'orcan workspaces\n'
    printf '────────────────────────────\n'
    if ((${#WS_NAMES[@]} == 0)); then
        printf '(no workspaces configured)\n'
        printf 'Add workspaces[] to orcan.config.json\n'
    else
        for i in "${!WS_NAMES[@]}"; do
            printf ' %d) %-16s %s\n' "$((i + 1))" "${WS_NAMES[i]}" "$(workspace_status "${WS_SESSIONS[i]}")"
            printf '    session: %s\n' "${WS_SESSIONS[i]}"
            printf '    %s\n' "${WS_ROOTS[i]}"
            if [[ -n "${WS_REPOS[i]}" ]]; then
                printf '    repos: %s\n' "${WS_REPOS[i]}"
            fi
            if [[ -n "${WS_HINTS[i]}" ]]; then
                printf '    context: %s\n' "${WS_HINTS[i]}"
            fi
        done
    fi
    printf '────────────────────────────\n'
    printf 'All sessions are started in the background.\n'
    printf 'In tmux: Ctrl+Space w (or s) = switch session · d = detach → menu\n'
    printf 'After ttyd reconnect: auto-reattach to last workspace (Enter during countdown = menu).\n'
    printf 'After make env: make init-project-all  (per-repo ignores)\n'
    printf 's) context status   i) init hint   r) refresh   q) quit\n'
    printf '\n'
}

ensure_sessions() {
    if command -v cursor-tmux-bootstrap-workspaces >/dev/null 2>&1; then
        cursor-tmux-bootstrap-workspaces || true
    fi
}

show_context_status() {
    if command -v orcan-context-status >/dev/null 2>&1; then
        ORCAN_CONFIG="${ORCAN_CONFIG}" orcan-context-status || true
    else
        printf 'orcan-context-status not available\n'
    fi
    printf '\nPress Enter…\n'
    read -r _ || true
}

show_init_hint() {
    printf '\nPer-repo ignores are not auto-written into checkouts.\n'
    printf 'Inside container:  orcan-init-projects\n'
    printf 'From host:         make init-project-all\n'
    printf 'Dry-run:           make init-project-all-dry-run\n'
    printf 'Status:            orcan-context-status\n'
    printf 'Session handoff:   orcan-session-brief   (alias: brief)\n'
    printf '\nPress Enter…\n'
    read -r _ || true
}

attach_workspace() {
    local index="$1"
    local name="${WS_NAMES[index]}"
    local root="${WS_ROOTS[index]}"
    local session="${WS_SESSIONS[index]}"

    if [[ ! -d "${root}" ]]; then
        printf 'Workspace root missing: %s\n' "${root}"
        printf 'Hint: make env && recreate the terminal container.\n'
        sleep 3
        return 0
    fi

    ensure_sessions
    save_last_workspace "${session}" "${root}" "${name}"
    printf 'Attaching session %s (%s)…\n' "${session}" "${name}"
    # Do not exec — after detach, return to this menu.
    cursor-tmux-workspace-attach "${session}" "${root}" "${name}" || true
}

fallback_single_repo() {
    [[ -n "${PROJECT_DIR}" && -d "${PROJECT_DIR}" ]] || return 1
    local name
    name="$(basename "${PROJECT_DIR}")"
    save_last_workspace "${name}" "${PROJECT_DIR}" "${name}"
    cursor-tmux-workspace-attach "${name}" "${PROJECT_DIR}" "${name}" || true
}

main() {
    local choice index

    # Once per ttyd client: recover last workspace after WebSocket reconnect.
    try_auto_reattach || true

    while true; do
        if ! load_workspaces; then
            if ! fallback_single_repo; then
                printf 'No workspaces configured.\n'
                sleep 2
            fi
            continue
        fi
        ensure_sessions
        print_menu

        if ! read -r -p 'Choose: ' choice; then
            printf '\n'
            exit 0
        fi

        case "${choice}" in
            q|Q) exit 0 ;;
            r|R|"") continue ;;
            s|S) show_context_status ;;
            i|I) show_init_hint ;;
            *)
                if [[ "${choice}" =~ ^[0-9]+$ ]]; then
                    index=$((choice - 1))
                    if (( index >= 0 && index < ${#WS_NAMES[@]} )); then
                        attach_workspace "${index}"
                    else
                        printf 'Enter 1-%d, s, i, r, or q.\n' "${#WS_NAMES[@]}"
                        sleep 1
                    fi
                else
                    printf 'Enter 1-%d, s, i, r, or q.\n' "${#WS_NAMES[@]}"
                    sleep 1
                fi
                ;;
        esac
    done
}

main "$@"
