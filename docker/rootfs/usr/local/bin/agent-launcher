#!/usr/bin/env bash
# ttyd's PTY command (see cursor-ttyd) and `orcan enter` / `cursor-launcher`
# entry point.
#
# Thin shim into the orcan-cockpit console script — a real uv-managed
# Python project at ../../../../cockpit (repo root: cockpit/pyproject.toml),
# installed at build time into its own isolated venv via `uv sync`
# (Dockerfile), never the system Python. See cockpit/src/orcan_cockpit/cli.py
# for the interactive-vs-non-tty-fallback logic.

set -Eeuo pipefail

# Keep the cockpit and its vendored ``orcan`` library from the same image.
# Searching arbitrary workspace checkouts here can pair an old cockpit with a
# newer image library and fail on imports removed between versions. Developer
# preview explicitly supplies its checkout through PYTHONPATH.
if [[ -z "${PYTHONPATH:-}" ]]; then
    export PYTHONPATH="/usr/local/lib"
fi

exec /opt/orcan-cockpit/venv/bin/orcan-cockpit "$@"
