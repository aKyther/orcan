#!/usr/bin/env bash
# Create detached tmux sessions for every cind workspace (idempotent).
# So Ctrl+Space w/s can switch between them without visiting the launcher first.
# Also kills tmux sessions that are no longer in config.
set -Eeuo pipefail

CIND_CONFIG="${CIND_CONFIG:-/etc/cind/config.json}"
TMUX_CONF="${TMUX_CONF:-${HOME}/.tmux.conf}"

[[ -f "${CIND_CONFIG}" ]] || exit 0

declare -a ACTIVE_SESSIONS=()

while IFS=$'\t' read -r name root session; do
    [[ -n "${name}" && -n "${root}" && -n "${session}" ]] || continue
    [[ -d "${root}" ]] || continue
    ACTIVE_SESSIONS+=("${session}")
    CIND_TMUX_ATTACH=0 cursor-tmux-workspace-attach "${session}" "${root}" "${name}" >/dev/null 2>&1 || true
done < <(python3 - "${CIND_CONFIG}" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as fh:
    cfg = json.load(fh)

workspaces = cfg.get("workspaces") or []
if not workspaces:
    legacy = cfg.get("workspace") or {}
    projects = cfg.get("projects") or []
    if legacy or projects:
        merged = dict(legacy)
        merged.setdefault("projects", projects)
        workspaces = [merged]

for ws in workspaces:
    if ws.get("enabled") is False:
        continue
    name = (ws.get("name") or "workspace").strip()
    root = (ws.get("root") or "").strip()
    session = (ws.get("tmux_session") or ws.get("tmux") or name).strip()
    if not name or not root:
        continue
    print(f"{name}\t{root}\t{session}")
PY
)

# Drop only cind-managed sessions left over after a workspace was removed from config.
# Sessions without CIND_WORKSPACE_NAME are left alone (user or smoke sessions).
if command -v tmux >/dev/null 2>&1; then
    while IFS= read -r live; do
        [[ -n "${live}" ]] || continue
        keep=0
        for s in "${ACTIVE_SESSIONS[@]+"${ACTIVE_SESSIONS[@]}"}"; do
            if [[ "${live}" == "${s}" ]]; then
                keep=1
                break
            fi
        done
        if (( keep == 1 )); then
            continue
        fi
        if ! tmux -f "${TMUX_CONF}" show-environment -t "=${live}" CIND_WORKSPACE_NAME >/dev/null 2>&1; then
            continue
        fi
        printf 'removing stale cind tmux session: %s\n' "${live}" >&2
        tmux -f "${TMUX_CONF}" kill-session -t "=${live}" 2>/dev/null || true
    done < <(tmux -f "${TMUX_CONF}" list-sessions -F '#{session_name}' 2>/dev/null || true)
fi
