#!/usr/bin/env bash
# Create detached tmux sessions for every orcan workspace (idempotent).
# So Ctrl+Space w/s can switch between them without visiting the launcher first.
#
# Thin entrypoint over orcan-tmux-reconcile-sessions — the shared
# reconcile_sessions(workspaces) mechanism also used by orcan-runtime-reconcile
# for on-demand runtime modification. Kept as a separate name for the
# existing call sites (agent-launcher, session-switch.sh); default policy is
# report-only for orphaned sessions (never kill an active agent's session
# just because its workspace disappeared from config).
set -Eeuo pipefail
exec orcan-tmux-reconcile-sessions "$@"
