#!/usr/bin/env python3
"""Review pending Context Assertion items from inside a workspace.

Candidates come from two places, merged into one list, reviewed the same way:

  - **Fresh, undecided drops in <workspace_root>/.orcan/context-inbox/** —
    read directly, no prior `orcan sync` needed, because a propose drop
    already carries its full content. [y]es / [n]o / [s]kip on one of these
    rewrites that same drop in place, setting its "decision" field — exactly
    what interactive `orcan-context-propose` already does by hand. One
    `orcan sync` afterward turns it into a real, git-versioned proposal
    *and* immediately applies the decision, in a single pass
    (compile_context.py's own inbox-decision handling, unchanged by this
    tool). Skipped ones are left alone and reappear next run.
  - **<workspace_root>/.orcan/context-review-queue.json's "candidates"** — a
    host-generated, read-only view of items already imported into the real
    store (status `proposed`): either drops from a *previous* `orcan sync`
    that weren't decided yet, or candidates proposed straight from the host
    (`orcan context assert propose`, which never touches the inbox at all).
    These already have a real store id, so [y]es/[n]o on one of these instead
    drops a small JSON file into <workspace_root>/.orcan/context-decisions/,
    applied at the *next* `orcan sync` (no live channel back to the host).

The queue also has a "reconsider" section — already-`accepted` assertions
someone flagged for a second look (via `orcan-context-propose
--flag-existing`, manually or from an automated Reflection pass). These
can *only* come from the queue (the flag drop itself carries no content to
show, just an id + reason — the real text lives only in the host-only
store). [k]eep / [r]etire / [s]kip -> decision keep/retire, same
context-decisions/ + next-sync mechanism. "keep" never mutates the store,
it just clears the flag.

This tool never reads or writes $ORCAN_DATA/context directly, whichever
candidate source is in play.

Before showing "candidates" (not "reconsider" — those were already decided
once), a best-effort duplicate/conflict pre-check runs one batched
`claude -p --model haiku` call comparing every pending candidate against
<workspace_root>/CONTEXT-ASSERTIONS.md (the compiled, currently-applicable
accepted set — the same file orcan-context-reflect already reads for its own
"already accepted" context). This never touches the host or the raw store,
never blocks review on failure, and never decides anything itself — it only
adds a note above a candidate you were going to see anyway. Skip it with
--no-check.

If you accept a candidate the pre-check flagged as a duplicate/conflict, you
get one more offer: queue a drafted consolidated replacement (folding the new
and existing content into one clearer item) and flag the existing item for
retirement. Both are just more `orcan-context-propose` drops — reviewed next
cycle like everything else, never applied directly.
"""
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
import uuid
from pathlib import Path

sys.path.insert(0, "/usr/local/lib")

from orcan.context_inbox import load_inbox_candidates  # noqa: E402

MAX_CONTEXT_CHARS = 8000
PROPOSE_BIN = Path(__file__).resolve().parent / "orcan-context-propose"

# Plain ANSI truecolor, not Rich: this script is deliberately stdlib-only
# (see the module docstring's own tooling — argparse/json/subprocess), and
# it only ever runs interactively in a real terminal (every branch below
# ends in input()), so there's no non-tty path to guard. Same hex palette
# as the rest of orcan's terminal UI (docs/*/guides/terminal-ui.md) — cyan
# for the actual decision prompt, amber for the one thing that's a genuine
# warning (a duplicate/conflict note), muted for supporting detail. Added
# because the actual "type here" prompt didn't stand out from the
# surrounding metadata — everything printed in the same plain white.
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"
CYAN = "\033[38;2;94;234;212m"
MUTED = "\033[38;2;100;116;139m"
AMBER = "\033[38;2;251;191;36m"


def die(msg: str) -> int:
    print(f"Error: {msg}", file=sys.stderr)
    return 1


def warn(msg: str) -> None:
    print(f"orcan-context-review: {msg}", file=sys.stderr)


def resolve_workspace_root(explicit: str) -> Path | None:
    import os

    raw = explicit or os.environ.get("ORCAN_WORKSPACE_ROOT") or str(Path.cwd())
    root = Path(raw)
    if not root.is_dir():
        return None
    return root.resolve()


def drop_decision(decisions_dir: Path, *, item_id: str, project_name: str, decision: str) -> None:
    decisions_dir.mkdir(parents=True, exist_ok=True)
    drop = decisions_dir / f"{uuid.uuid4().hex[:12]}.json"
    drop.write_text(
        json.dumps({"id": item_id, "project_name": project_name, "decision": decision}, indent=2) + "\n",
        encoding="utf-8",
    )


def write_inbox_decision(drop_path: Path, decision: str) -> None:
    try:
        payload = json.loads(drop_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        warn(f"could not record decision on {drop_path.name} (unreadable)")
        return
    payload["decision"] = decision
    drop_path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")


def extract_json_array(raw: str) -> list[dict]:
    text = raw.strip()
    if text.startswith("```"):
        text = text.strip("`")
        if text.startswith("json"):
            text = text[4:]
    start, end = text.find("["), text.rfind("]")
    if start == -1 or end == -1 or end < start:
        return []
    try:
        data = json.loads(text[start : end + 1])
    except json.JSONDecodeError:
        return []
    return data if isinstance(data, list) else []


def build_check_prompt(candidates: list[dict], existing_context: str) -> str:
    listed = "\n".join(
        f"- candidate_id: {c.get('id')}\n"
        f"  title: {c.get('title')!r}\n"
        f"  content: {c.get('content')}"
        for c in candidates
    )
    return f"""You are a duplicate/conflict check for a coding assistant's context store.
Below is a list of NEW candidate facts awaiting human review, and the context
already accepted for this workspace (each item's id shown as `id: ...`).

For EACH candidate, decide:
  - "novel": genuinely new, no overlap with anything already accepted.
  - "duplicate": already covered (even if worded differently) by an existing item.
  - "conflict": contradicts an existing item.

For any candidate you mark "duplicate" or "conflict", also draft a single
consolidated replacement that folds the candidate and the related existing
item into one clearer, non-redundant assertion — keep everything true from
both, resolve the wording overlap, keep it concise.

Output ONLY a JSON array (no prose, no markdown fences), one element per
candidate_id, in this shape:
  {{"candidate_id": "...", "verdict": "novel"|"duplicate"|"conflict",
    "related_id": "...", "related_title": "...", "note": "...",
    "consolidated_title": "...", "consolidated_content": "..."}}
Omit related_id/related_title/note/consolidated_title/consolidated_content
(or leave empty) when verdict is "novel".
Be conservative — only flag duplicate/conflict when you're confident. This is
a nudge for a human reviewer, not a decision — they see every candidate
regardless of your verdict, and nothing is ever merged automatically.

=== Already accepted ===
{existing_context}

=== New candidates awaiting review ===
{listed}
"""


def run_duplicate_check(candidates: list[dict], workspace_root: Path, model: str) -> dict[str, dict]:
    """Best-effort — never raises, never blocks review. Returns {candidate_id: annotation}."""
    if not candidates:
        return {}
    pack_path = workspace_root / "CONTEXT-ASSERTIONS.md"
    if not pack_path.is_file():
        return {}
    claude = shutil.which("claude")
    if not claude:
        warn(
            "duplicate/conflict check skipped: claude not on PATH "
            "(install Claude Code in the container, or pass --no-check)"
        )
        return {}
    existing_context = pack_path.read_text(encoding="utf-8")
    if len(existing_context) > MAX_CONTEXT_CHARS:
        existing_context = existing_context[-MAX_CONTEXT_CHARS:]

    prompt = build_check_prompt(candidates, existing_context)
    try:
        result = subprocess.run(
            [claude, "-p", "--model", model, prompt],
            capture_output=True,
            text=True,
            timeout=120,
            stdin=subprocess.DEVNULL,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        warn(f"duplicate/conflict check skipped: {exc}")
        return {}
    if result.returncode != 0:
        warn(f"duplicate/conflict check skipped: model call exited {result.returncode}")
        return {}

    annotations: dict[str, dict] = {}
    for item in extract_json_array(result.stdout):
        if not isinstance(item, dict):
            continue
        cid = str(item.get("candidate_id") or "")
        verdict = str(item.get("verdict") or "")
        if cid and verdict in ("duplicate", "conflict"):
            annotations[cid] = item
    return annotations


def queue_consolidation(item: dict, note: dict, workspace_root: Path) -> bool:
    """Best-effort — never raises, never blocks review. True if both drops queued."""
    project = str(item.get("project_name") or "")
    related_id = str(note.get("related_id") or "").strip()
    consolidated_title = str(note.get("consolidated_title") or "").strip()
    consolidated_content = str(note.get("consolidated_content") or "").strip()
    if not project or not related_id or not consolidated_content:
        warn("consolidation queue skipped: model response missing required fields")
        return False

    calls = [
        [
            sys.executable,
            str(PROPOSE_BIN),
            "--workspace-root",
            str(workspace_root),
            "--project",
            project,
            "--text",
            consolidated_content,
            "--title",
            consolidated_title,
            "--justification",
            f"Consolidated from accepted candidate {item.get('id')} and existing {related_id}",
            "--kind",
            "fact",
            "--source",
            "consolidation",
            "--queue",
        ],
        [
            sys.executable,
            str(PROPOSE_BIN),
            "--workspace-root",
            str(workspace_root),
            "--project",
            project,
            "--flag-existing",
            related_id,
            "--reason",
            "superseded by consolidated version",
        ],
    ]
    ok = True
    for call_args in calls:
        try:
            result = subprocess.run(
                call_args, capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            warn(f"consolidation queue failed: {exc}")
            ok = False
            continue
        if result.returncode != 0:
            warn(f"consolidation queue failed: {result.stderr.strip()[:200]}")
            ok = False
    return ok


def format_scope_chip(applicability: dict | None) -> str:
    """Compact IDE-style scope label for a candidate."""
    if not applicability:
        return "scope: always"
    bits: list[str] = []
    branch = applicability.get("branch")
    if branch:
        bits.append(f"branch={branch}")
    workspace = applicability.get("workspace")
    if workspace:
        bits.append(f"workspace={workspace}")
    for key in ("repo_set_all", "repo_set_any"):
        val = applicability.get(key)
        if val:
            bits.append(f"{key}={val}")
    return "scope: " + (", ".join(str(b) for b in bits) if bits else "always")


def review_candidates(
    items: list[dict], decisions_dir: Path, annotations: dict[str, dict], workspace_root: Path
) -> int:
    decided = 0
    total = len(items)
    for index, item in enumerate(items, start=1):
        title = item.get("title") or "(no title)"
        body = item.get("content") or "(no body)"
        print()
        print(
            f"{DIM}[{index}/{total}]{RESET} {BOLD}── Project: "
            f"{item.get('project_name') or '?'} ──{RESET}"
        )
        print(f"  {BOLD}NOTE (this text becomes lasting project context if you accept):{RESET}")
        print(f"    Title: {title}")
        print(f"    Body:  {body}")
        print(f"  {MUTED}Pack preview (after orcan sync):{RESET}")
        print(f"    ## {title}")
        for line in str(body).splitlines() or [""]:
            print(f"    {line}")
        note = annotations.get(str(item.get("id") or ""))
        if note:
            verb = "may conflict with" if note.get("verdict") == "conflict" else "possibly duplicates"
            related = note.get("related_title") or note.get("related_id") or "an existing item"
            extra = f" — {note['note']}" if note.get("note") else ""
            print(f"  {AMBER}⚠ {verb} existing: {related!r}{extra}{RESET}")
        justification = item.get("justification")
        if justification:
            print(f"  {MUTED}Why proposed: {justification}{RESET}")
        applicability = item.get("applicability") or {}
        print(f"  {CYAN}{format_scope_chip(applicability if isinstance(applicability, dict) else {})}{RESET}")
        print(
            f"  {MUTED}Kind: {item.get('epistemic_status', 'fact')}  "
            f"Criticality: {item.get('criticality', 'normal')}{RESET}"
        )
        relations = item.get("relations") or []
        if relations:
            print(f"  {MUTED}Relations: {relations}{RESET}")
        print()
        while True:
            choice = input(
                f"  {BOLD}{CYAN}Accept this note into project context? "
                f"[y]es / [n]o / [s]kip:{RESET} "
            ).strip().lower()
            if choice in ("y", "yes", "n", "no", "s", "skip", ""):
                break
            print("  Please answer y, n, or s.")
        if choice in ("s", "skip", ""):
            continue
        decision = "accept" if choice in ("y", "yes") else "reject"
        if item.get("_source") == "inbox":
            write_inbox_decision(item["_drop_path"], decision)
        else:
            drop_decision(
                decisions_dir, item_id=item.get("id"), project_name=item.get("project_name"), decision=decision
            )
        decided += 1
        if decision == "accept" and note and note.get("consolidated_content"):
            related = note.get("related_title") or note.get("related_id") or "the existing item"
            while True:
                merge_choice = input(
                    f"  Also queue a consolidated version merging this with {related!r} "
                    f"(id {note.get('related_id')}), and flag it for retirement? [y]es / [n]o: "
                ).strip().lower()
                if merge_choice in ("y", "yes", "n", "no", ""):
                    break
                print("  Please answer y or n.")
            if merge_choice in ("y", "yes"):
                if queue_consolidation(item, note, workspace_root):
                    print("  Queued — review the consolidated candidate and the retirement flag next cycle.")
                else:
                    print("  Could not queue consolidation (see warning above) — original accept still recorded.")
    return decided


def review_reconsider(items: list[dict], decisions_dir: Path) -> int:
    decided = 0
    total = len(items)
    for index, item in enumerate(items, start=1):
        title = item.get("title") or "(no title)"
        body = item.get("content") or "(no body)"
        print()
        print(
            f"{DIM}[{index}/{total}]{RESET} {BOLD}── Project: "
            f"{item.get('project_name') or '?'} · already accepted, flagged ──{RESET}"
        )
        print(f"  {BOLD}NOTE (already in context — keep or retire):{RESET}")
        print(f"    Title: {title}")
        print(f"    Body:  {body}")
        if item.get("justification"):
            print(f"  {MUTED}Why it was accepted: {item.get('justification')}{RESET}")
        if item.get("reason"):
            print(f"  {MUTED}Why flagged now: {item.get('reason')}{RESET}")
        print()
        while True:
            choice = input(f"  {BOLD}{CYAN}Decision: [k]eep / [r]etire / [s]kip:{RESET} ").strip().lower()
            if choice in ("k", "keep", "r", "retire", "s", "skip", ""):
                break
            print("  Please answer k, r, or s.")
        if choice in ("s", "skip", ""):
            continue
        decision = "retire" if choice in ("r", "retire") else "keep"
        drop_decision(decisions_dir, item_id=item.get("id"), project_name=item.get("project_name"), decision=decision)
        decided += 1
    return decided


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "workspace_root", nargs="?", default="", help="Defaults to $ORCAN_WORKSPACE_ROOT or cwd"
    )
    parser.add_argument(
        "--no-check",
        action="store_true",
        help="Skip the duplicate/conflict pre-check against CONTEXT-ASSERTIONS.md",
    )
    parser.add_argument(
        "--model", default="haiku", help="Model used for the duplicate/conflict check (default: haiku)"
    )
    args = parser.parse_args()

    workspace_root = resolve_workspace_root(args.workspace_root)
    if workspace_root is None:
        return die("could not resolve workspace root ($ORCAN_WORKSPACE_ROOT or cwd)")

    inbox_candidates = load_inbox_candidates(workspace_root)

    queue_candidates: list[dict] = []
    reconsider: list[dict] = []
    queue_path = workspace_root / ".orcan" / "context-review-queue.json"
    if queue_path.is_file():
        try:
            queue = json.loads(queue_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            return die(f"invalid review queue {queue_path}: {exc}")
        for c in queue.get("candidates") or []:
            c = dict(c)
            c["_source"] = "queue"
            queue_candidates.append(c)
        reconsider = queue.get("reconsider") or []

    candidates = inbox_candidates + queue_candidates
    if not candidates and not reconsider:
        print("No pending context assertions.")
        return 0

    annotations: dict[str, dict] = {}
    if candidates and not args.no_check:
        annotations = run_duplicate_check(candidates, workspace_root, args.model)

    decisions_dir = workspace_root / ".orcan" / "context-decisions"
    decided = 0
    if candidates:
        if inbox_candidates and queue_candidates:
            print(
                f"== {len(candidates)} new candidate(s) "
                f"({len(inbox_candidates)} fresh from inbox, {len(queue_candidates)} already queued) =="
            )
        else:
            print(f"== {len(candidates)} new candidate(s) ==")
        print(
            "Each item is a proposed NOTE for lasting project context "
            "(agents read accepted notes after `orcan sync`). "
            "y = keep · n = drop · s = decide later."
        )
        decided += review_candidates(candidates, decisions_dir, annotations, workspace_root)
    if reconsider:
        print(f"\n== {len(reconsider)} flagged for reconsideration ==")
        decided += review_reconsider(reconsider, decisions_dir)

    if decided:
        print(f"\n{decided} decision(s) recorded — applied at the next `orcan sync`.")
    else:
        print("\nNo decisions recorded.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
