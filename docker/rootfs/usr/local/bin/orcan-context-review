#!/usr/bin/env python3
"""Review pending Context Assertion items from inside a workspace.

Reads <workspace_root>/.orcan/context-review-queue.json — a host-generated,
read-only view with two sections (written by `orcan sync` /
compile_context.py). This tool never reads or writes $ORCAN_DATA/context
directly:

  - "candidates": new, not-yet-decided proposals (status `proposed`).
    [y]es / [n]o / [s]kip -> decision accept/reject.
  - "reconsider": already-`accepted` assertions someone flagged for a second
    look (via `orcan-context-propose --flag-existing`, manually or from an
    automated Reflection pass). [k]eep / [r]etire / [s]kip -> decision
    keep/retire. "keep" never mutates the store — it just clears the flag.

Each decision drops a small JSON file into <workspace_root>/.orcan/context-decisions/
— applied to the real, git-versioned store at the *next* `orcan sync` (there
is no live channel back to the host, so this is a queued decision, not an
instant one).
"""
from __future__ import annotations

import json
import sys
import uuid
from pathlib import Path


def die(msg: str) -> int:
    print(f"Error: {msg}", file=sys.stderr)
    return 1


def resolve_workspace_root(explicit: str) -> Path | None:
    import os

    raw = explicit or os.environ.get("ORCAN_WORKSPACE_ROOT") or str(Path.cwd())
    root = Path(raw)
    if not root.is_dir():
        return None
    return root.resolve()


def drop_decision(decisions_dir: Path, *, item_id: str, project_name: str, decision: str) -> None:
    decisions_dir.mkdir(parents=True, exist_ok=True)
    drop = decisions_dir / f"{uuid.uuid4().hex[:12]}.json"
    drop.write_text(
        json.dumps({"id": item_id, "project_name": project_name, "decision": decision}, indent=2) + "\n",
        encoding="utf-8",
    )


def review_candidates(items: list[dict], decisions_dir: Path) -> int:
    decided = 0
    for item in items:
        print()
        print(f"[{item.get('project_name')}] {item.get('title')!r}")
        print(f"  {item.get('content')}")
        print(f"  Problem it solves: {item.get('justification')}")
        applicability = item.get("applicability") or {}
        print(f"  Applicability: {applicability or '(unconditional under this project)'}")
        print(
            f"  Epistemic status: {item.get('epistemic_status', 'fact')}  "
            f"Criticality: {item.get('criticality', 'normal')}"
        )
        relations = item.get("relations") or []
        if relations:
            print(f"  Relations: {relations}")
        while True:
            choice = input("  Decision: [y]es / [n]o / [s]kip: ").strip().lower()
            if choice in ("y", "yes", "n", "no", "s", "skip", ""):
                break
            print("  Please answer y, n, or s.")
        if choice in ("s", "skip", ""):
            continue
        decision = "accept" if choice in ("y", "yes") else "reject"
        drop_decision(decisions_dir, item_id=item.get("id"), project_name=item.get("project_name"), decision=decision)
        decided += 1
    return decided


def review_reconsider(items: list[dict], decisions_dir: Path) -> int:
    decided = 0
    for item in items:
        print()
        print(f"[{item.get('project_name')}] Reconsider: {item.get('title')!r}")
        print(f"  {item.get('content')}")
        print(f"  Why it was accepted: {item.get('justification')}")
        print(f"  Why it's flagged now: {item.get('reason')}")
        while True:
            choice = input("  Decision: [k]eep / [r]etire / [s]kip: ").strip().lower()
            if choice in ("k", "keep", "r", "retire", "s", "skip", ""):
                break
            print("  Please answer k, r, or s.")
        if choice in ("s", "skip", ""):
            continue
        decision = "retire" if choice in ("r", "retire") else "keep"
        drop_decision(decisions_dir, item_id=item.get("id"), project_name=item.get("project_name"), decision=decision)
        decided += 1
    return decided


def main() -> int:
    workspace_root = resolve_workspace_root(sys.argv[1] if len(sys.argv) > 1 else "")
    if workspace_root is None:
        return die("could not resolve workspace root ($ORCAN_WORKSPACE_ROOT or cwd)")

    queue_path = workspace_root / ".orcan" / "context-review-queue.json"
    if not queue_path.is_file():
        print("No pending context assertions (queue file not found yet — run `orcan sync` on the host first).")
        return 0

    try:
        queue = json.loads(queue_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        return die(f"invalid review queue {queue_path}: {exc}")

    candidates = queue.get("candidates") or []
    reconsider = queue.get("reconsider") or []
    if not candidates and not reconsider:
        print("No pending context assertions.")
        return 0

    decisions_dir = workspace_root / ".orcan" / "context-decisions"
    decided = 0
    if candidates:
        print(f"== {len(candidates)} new candidate(s) ==")
        decided += review_candidates(candidates, decisions_dir)
    if reconsider:
        print(f"\n== {len(reconsider)} flagged for reconsideration ==")
        decided += review_reconsider(reconsider, decisions_dir)

    if decided:
        print(f"\n{decided} decision(s) recorded — applied at the next `orcan sync`.")
    else:
        print("\nNo decisions recorded.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
