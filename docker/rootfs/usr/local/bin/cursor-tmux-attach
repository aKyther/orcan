#!/usr/bin/env bash
# Attach to a project tmux session; bootstrap windows on first create.
# Usage: cursor-tmux-attach SESSION PROJECT_PATH PROJECT_LABEL
set -Eeuo pipefail

SESSION="${1:-}"
PROJECT_PATH="${2:-}"
PROJECT_LABEL="${3:-}"
CIND_CONFIG="${CIND_CONFIG:-/etc/cind/config.json}"

if [[ -z "${SESSION}" || -z "${PROJECT_PATH}" ]]; then
    echo "Usage: cursor-tmux-attach SESSION PROJECT_PATH [PROJECT_LABEL]" >&2
    exit 1
fi

if [[ ! -d "${PROJECT_PATH}" ]]; then
    echo "Project path does not exist: ${PROJECT_PATH}" >&2
    exit 1
fi

PROJECT_PATH="$(cd -- "${PROJECT_PATH}" && pwd -P)"
PROJECT_LABEL="${PROJECT_LABEL:-$(basename "${PROJECT_PATH}")}"

export PROJECT_DIR="${PROJECT_PATH}"
export CIND_PROJECT_NAME="${PROJECT_LABEL}"
export CIND_PROJECT_PATH="${PROJECT_PATH}"

sanitize_session_name() {
    local name="$1"
    name="$(printf '%s' "${name}" | tr -c 'A-Za-z0-9_-' '_')"
    name="${name##_}"
    name="${name%%_}"
    [[ -n "${name}" ]] || name="project"
    printf '%s\n' "${name:0:50}"
}

SESSION="$(sanitize_session_name "${SESSION}")"

TMUX_CONF="${TMUX_CONF:-${HOME}/.tmux.conf}"
mkdir -p "${HOME}/.cache/tmux" 2>/dev/null || true

tmux_cmd() {
    tmux -f "${TMUX_CONF}" "$@"
}

set_session_env() {
    tmux_cmd set-environment -t "=${SESSION}" CIND_PROJECT_NAME "${PROJECT_LABEL}" 2>/dev/null || true
    tmux_cmd set-environment -t "=${SESSION}" CIND_PROJECT_PATH "${PROJECT_PATH}" 2>/dev/null || true
    tmux_cmd set-environment -t "=${SESSION}" PROJECT_DIR "${PROJECT_PATH}" 2>/dev/null || true
}

resolve_window_dir() {
    local rel="$1"
    local base="${PROJECT_PATH}"
    if [[ "${rel}" == "." || -z "${rel}" ]]; then
        printf '%s\n' "${base}"
    elif [[ "${rel}" == /* ]]; then
        printf '%s\n' "${rel}"
    else
        printf '%s\n' "${base}/${rel}"
    fi
}

fetch_windows_from_config() {
    local session_name="$1"
    local project_path="$2"
    [[ -f "${CIND_CONFIG}" ]] || return 1
    python3 - "${CIND_CONFIG}" "${session_name}" "${project_path}" <<'PY'
import json, sys
from pathlib import Path

config_path, session_name, project_path = sys.argv[1:4]
with open(config_path, encoding="utf-8") as fh:
    cfg = json.load(fh)

projects = cfg.get("projects") or []
match = None
for item in projects:
    tmux = (item.get("tmux") or item.get("name") or "").strip()
    path = (item.get("path") or "").strip()
    if tmux == session_name or path == project_path:
        match = item
        break

windows = (match or {}).get("windows") or []
if not windows:
    sys.exit(1)

for w in windows:
    name = (w.get("name") or "shell").strip()
    icon = (w.get("icon") or "").strip()
    directory = (w.get("dir") or ".").strip()
    command = (w.get("command") or "").strip()
    label = f"{icon} {name}".strip() if icon else name
    print(f"{label}\t{directory}\t{command}")
PY
}

default_windows() {
    local project_path="$1"
    printf '%s\t%s\t\n' "🖥 shell" "."
    printf '%s\t%s\t\n' "📝 editor" "."
    printf '%s\t%s\t\n' "⚙ logs" "."
    if [[ -d "${project_path}/tests" || -d "${project_path}/test" ]]; then
        printf '%s\t%s\t\n' "🧪 tests" "tests"
    fi
}

first_window_target() {
    local idx
    idx="$(tmux_cmd list-windows -t "=${SESSION}" -F '#{window_index}' 2>/dev/null | sort -n | head -1)"
    [[ -n "${idx}" ]] || idx="0"
    printf '=%s:%s\n' "${SESSION}" "${idx}"
}

create_window() {
    local index="$1"
    local title="$2"
    local dir="$3"
    local command="$4"
    local target

    dir="$(resolve_window_dir "${dir}")"
    mkdir -p "${dir}" 2>/dev/null || true

    if (( index == 1 )); then
        target="$(first_window_target)"
        tmux_cmd rename-window -t "${target}" "${title}"
        if [[ "${dir}" != "${PROJECT_PATH}" ]]; then
            tmux_cmd send-keys -t "${target}" "cd -- $(printf '%q' "${dir}")" C-m
        fi
    else
        tmux_cmd new-window -t "=${SESSION}" -n "${title}" -c "${dir}"
        target="=${SESSION}:${title}"
    fi

    if [[ -n "${command}" && "${command}" != "bash" ]]; then
        tmux_cmd send-keys -t "${target}" "${command}" C-m
    fi
}

bootstrap_session() {
    local line title dir command index=1
    local had_config=0

    tmux_cmd new-session -d -s "${SESSION}" -c "${PROJECT_PATH}" -n "🖥 shell"
    set_session_env

    if fetch_windows_from_config "${SESSION}" "${PROJECT_PATH}" >"${HOME}/.cache/tmux/bootstrap.${SESSION}.lst" 2>/dev/null; then
        had_config=1
    else
        default_windows "${PROJECT_PATH}" >"${HOME}/.cache/tmux/bootstrap.${SESSION}.lst"
    fi

    while IFS=$'\t' read -r title dir command; do
        [[ -n "${title}" ]] || continue
        create_window "${index}" "${title}" "${dir:-.}" "${command:-}"
        index=$((index + 1))
    done <"${HOME}/.cache/tmux/bootstrap.${SESSION}.lst"

    rm -f "${HOME}/.cache/tmux/bootstrap.${SESSION}.lst"
    tmux_cmd select-window -t "$(first_window_target)"
}

if tmux_cmd has-session -t "=${SESSION}" 2>/dev/null; then
    set_session_env
    cd "${PROJECT_PATH}"
    if [[ "${CIND_TMUX_ATTACH:-1}" == "0" ]]; then
        exit 0
    fi
    exec tmux -f "${TMUX_CONF}" attach -t "=${SESSION}"
fi

bootstrap_session
cd "${PROJECT_PATH}"
if [[ "${CIND_TMUX_ATTACH:-1}" == "0" ]]; then
    exit 0
fi
exec tmux -f "${TMUX_CONF}" attach -t "=${SESSION}"
