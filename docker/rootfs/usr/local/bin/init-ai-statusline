#!/usr/bin/env python3
"""Ensure Claude / Cursor statusLine hooks and secret deny rules (additive)."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

# Merged into ~/.claude/settings.json permissions.deny when missing.
# Claude Code file checks match Read(path) and Edit(path) only — Write(path)
# rules warn and never match (Edit covers all file-editing tools).
SECRET_DENY = [
    "Read(**/.env)",
    "Read(**/.env.*)",
    "Read(**/*.pem)",
    "Read(**/*.key)",
    "Read(**/id_rsa)",
    "Read(**/id_ed25519)",
    "Read(**/secrets/**)",
    "Read(**/credentials.json)",
    "Edit(**/.env)",
    "Edit(**/.env.*)",
    "Edit(**/*.pem)",
    "Edit(**/*.key)",
]

# Path-form Write/NotebookEdit/Glob rules are obsolete noise; drop on refresh.
_OBSOLETE_FILE_RULE_PREFIXES = ("Write(", "NotebookEdit(", "Glob(")


def load_json(path: Path) -> dict:
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def ensure_statusline(path: Path, status_block: dict, *, create_if_missing: bool) -> str:
    if not path.exists() and not create_if_missing:
        return f"skipped (missing): {path}"
    data = load_json(path)
    existing = data.get("statusLine")
    if isinstance(existing, dict) and str(existing.get("command") or "").strip():
        return f"kept statusLine: {path}"
    data["statusLine"] = status_block
    write_json(path, data)
    return f"set statusLine: {path}"


def _is_obsolete_file_rule(rule: str) -> bool:
    """True for Write(path)/NotebookEdit(path)/Glob(path) — never matched."""
    text = str(rule).strip()
    if not text.endswith(")"):
        return False
    return any(text.startswith(prefix) for prefix in _OBSOLETE_FILE_RULE_PREFIXES)


def ensure_secret_denies(path: Path) -> str:
    """Add secret deny rules; strip obsolete Write/NotebookEdit/Glob path rules."""
    data = load_json(path) if path.exists() else {}
    perms = data.get("permissions")
    if not isinstance(perms, dict):
        perms = {}
    deny = perms.get("deny")
    if not isinstance(deny, list):
        deny = []
    cleaned: list[object] = []
    removed = 0
    for rule in deny:
        if _is_obsolete_file_rule(str(rule)):
            removed += 1
            continue
        cleaned.append(rule)
    deny = cleaned
    existing = {str(x) for x in deny}
    added = 0
    for rule in SECRET_DENY:
        if rule not in existing:
            deny.append(rule)
            existing.add(rule)
            added += 1
    perms["deny"] = deny
    data["permissions"] = perms
    write_json(path, data)
    parts: list[str] = []
    if removed:
        parts.append(f"removed {removed} obsolete Write/NotebookEdit/Glob rule(s)")
    if added:
        parts.append(f"added {added} secret deny rule(s)")
    if parts:
        return f"{'; '.join(parts)}: {path}"
    return f"secret denies ok: {path}"


def main() -> int:
    home = Path(os.environ.get("HOME") or "").expanduser()
    if not str(home):
        print("HOME is not set", file=sys.stderr)
        return 1

    cmd = os.environ.get("ORCAN_AI_STATUSLINE", "/usr/local/bin/orcan-ai-statusline")
    status_block = {"type": "command", "command": cmd, "padding": 0}
    claude_settings = home / ".claude" / "settings.json"

    print(
        ensure_statusline(
            claude_settings,
            status_block,
            create_if_missing=True,
        )
    )
    print(ensure_secret_denies(claude_settings))
    print(
        ensure_statusline(
            home / ".cursor" / "cli-config.json",
            status_block,
            create_if_missing=False,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
