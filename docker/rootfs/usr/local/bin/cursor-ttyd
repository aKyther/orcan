#!/usr/bin/env bash
# Start ttyd with the project launcher (tmux session per project).
# Runs after docker-entrypoint (init-cursor-home). No authentication — local/Tailscale only.

set -Eeuo pipefail

TTYD_PORT="${TTYD_PORT:-7681}"
# xterm.js default is ~15px; 22 reads better on phone browsers.
TTYD_FONT_SIZE="${TTYD_FONT_SIZE:-22}"

printf 'ttyd ready: http://0.0.0.0:%s (project launcher + tmux, fontSize=%s)\n' \
    "${TTYD_PORT}" "${TTYD_FONT_SIZE}" >&2
printf 'WARNING: Do not expose this port to the public Internet without authentication and TLS.\n' >&2

exec ttyd \
    --writable \
    --interface 0.0.0.0 \
    --port "${TTYD_PORT}" \
    --client-option "fontSize=${TTYD_FONT_SIZE}" \
    cursor-launcher
