#!/usr/bin/env bash
# Start ttyd with the project launcher (tmux session per project).
# Runs after docker-entrypoint (init-cursor-home).
# Optional HTTP basic auth via TTYD_CREDENTIAL=user:password.
# Prefer host publish on 127.0.0.1 (Compose TTYD_BIND) and/or Tailscale.

set -Eeuo pipefail

TTYD_PORT="${TTYD_PORT:-7681}"
# xterm.js default is ~15px; 19 (the old default here) read noticeably
# larger/bulkier than a typical code editor terminal once other panels
# (cockpit rail/hints/status) were added around it — 14 matches VS Code's
# integrated-terminal density. Desktop defaults to 13; the injected browser
# bridge selects 14 on tablets and 16 on phones. TTYD_FONT_SIZE still controls
# desktop, while an explicit ?fontSize=N URL value overrides responsive sizes.
TTYD_FONT_SIZE="${TTYD_FONT_SIZE:-13}"
if [[ -z "${TTYD_FONT_FAMILY:-}" ]]; then
    TTYD_FONT_FAMILY="Menlo, Monaco, 'Courier New', monospace"
fi
# Preset name (dark|navy|mocha) or a raw JSON object for xterm.js theme.
if [[ -z "${TTYD_THEME:-}" ]]; then
    TTYD_THEME="dark"
fi

# Default: graphite / near-black / muted plum (matches /etc/tmux status).
# ANSI hues remain distinct for logs, diffs, tests, and application state.
TTYD_THEME_NAVY='{"background":"#0e0c13","foreground":"#d8d2e2","cursor":"#9b87b8","cursorAccent":"#0e0c13","selectionBackground":"#382e46","black":"#141119","red":"#d98282","green":"#85ad8c","yellow":"#c9a86a","blue":"#8498bd","magenta":"#9b87b8","cyan":"#82aaa7","white":"#d8d2e2","brightBlack":"#554e61","brightRed":"#e2a0a0","brightGreen":"#a3c5a8","brightYellow":"#d7bd8d","brightBlue":"#a2b1cc","brightMagenta":"#b9a7d6","brightCyan":"#a0c1be","brightWhite":"#eee9f2"}'

# Legacy Catppuccin Mocha — opt in with TTYD_THEME=mocha.
TTYD_THEME_MOCHA='{"background":"#1e1e2e","foreground":"#cdd6f4","cursor":"#f5e0dc","selectionBackground":"#585b70","black":"#45475a","red":"#f38ba8","green":"#a6e3a1","yellow":"#f9e2af","blue":"#89b4fa","magenta":"#f5c2e7","cyan":"#94e2d5","white":"#bac2de","brightBlack":"#585b70","brightRed":"#f38ba8","brightGreen":"#a6e3a1","brightYellow":"#f9e2af","brightBlue":"#89b4fa","brightMagenta":"#f5c2e7","brightCyan":"#94e2d5","brightWhite":"#a6adc8"}'

resolve_theme() {
    case "${TTYD_THEME}" in
        dark|navy|"")
            printf '%s' "${TTYD_THEME_NAVY}"
            ;;
        mocha|catppuccin)
            printf '%s' "${TTYD_THEME_MOCHA}"
            ;;
        \{*)
            printf '%s' "${TTYD_THEME}"
            ;;
        *)
            printf '%s' "${TTYD_THEME_NAVY}"
            ;;
    esac
}

THEME_JSON="$(resolve_theme)"

# WebSocket ping; ~20s keeps typical cellular NAT (~30s) without noisy 5s defaults.
TTYD_PING_INTERVAL="${TTYD_PING_INTERVAL:-20}"
if ! [[ "${TTYD_PING_INTERVAL}" =~ ^[0-9]+$ ]] || (( TTYD_PING_INTERVAL < 1 )); then
    TTYD_PING_INTERVAL=20
fi

TTYD_ARGS=(
    --writable
    --index /opt/orcan/ttyd-index.html
    --interface 0.0.0.0
    --port "${TTYD_PORT}"
    --ping-interval "${TTYD_PING_INTERVAL}"
    --client-option "fontSize=${TTYD_FONT_SIZE}"
    --client-option "fontFamily=${TTYD_FONT_FAMILY}"
    --client-option "theme=${THEME_JSON}"
    # macOS: Option/Alt composes accented/special characters (Option+1 → "¡",
    # Option+2 → "™", …) by default in xterm.js, instead of sending it as
    # ESC-prefixed Meta — which is what tmux's M-1..M-9 window binds
    # (/etc/tmux/keybindings.conf) and the cockpit's own alt+ handling
    # (pty_terminal.py) both expect. No effect on Windows/Linux, where
    # xterm.js already sends Alt as Meta natively.
    --client-option "macOptionIsMeta=true"
    # Without this, xterm.js follows the terminal's own OSC title updates
    # (tmux's set-titles-string), so the tab reads "1:tab-1 [...]" instead
    # of anything recognizably orcan. titleFixed locks it to a constant —
    # confirmed present in ttyd's actual bundled JS (grepped the served
    # page's own inline script), not just documented behavior.
    --client-option "titleFixed=🌀 orcan"
)

if [[ -n "${TTYD_CREDENTIAL:-}" ]]; then
    if [[ "${TTYD_CREDENTIAL}" != *:* ]]; then
        printf 'ERROR: TTYD_CREDENTIAL must be user:password\n' >&2
        exit 1
    fi
    TTYD_ARGS+=(--credential "${TTYD_CREDENTIAL}")
    auth_note="basic-auth on"
else
    auth_note="no auth (rely on TTYD_BIND / Tailscale)"
fi

printf 'ttyd ready: container :%s (%s, fontSize=%s, ping=%ss)\n' \
    "${TTYD_PORT}" "${auth_note}" "${TTYD_FONT_SIZE}" "${TTYD_PING_INTERVAL}" >&2
printf 'WARNING: Do not expose this port to the public Internet without authentication and TLS.\n' >&2

exec ttyd "${TTYD_ARGS[@]}" agent-launcher
