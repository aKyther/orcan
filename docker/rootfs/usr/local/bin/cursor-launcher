#!/usr/bin/env bash
# Workspace picker for ttyd — one tmux session per workspace.
# Phone-friendly: choose by number.

set -Eeuo pipefail

CIND_CONFIG="${CIND_CONFIG:-/etc/cind/config.json}"
PROJECT_DIR="${PROJECT_DIR:-}"

declare -a WS_NAMES=()
declare -a WS_ROOTS=()
declare -a WS_SESSIONS=()
declare -a WS_REPOS=()

load_workspaces() {
    WS_NAMES=()
    WS_ROOTS=()
    WS_SESSIONS=()
    WS_REPOS=()

    [[ -f "${CIND_CONFIG}" ]] || return 1

    while IFS=$'\t' read -r name root session repos; do
        [[ -n "${name}" ]] || continue
        WS_NAMES+=("${name}")
        WS_ROOTS+=("${root}")
        WS_SESSIONS+=("${session}")
        WS_REPOS+=("${repos}")
    done < <(python3 - "${CIND_CONFIG}" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as fh:
    cfg = json.load(fh)

workspaces = cfg.get("workspaces") or []
if not workspaces:
    legacy = cfg.get("workspace") or {}
    if legacy.get("enabled") is False:
        raise SystemExit(1)
    projects = cfg.get("projects") or []
    if legacy or projects:
        merged = dict(legacy)
        merged.setdefault("projects", projects)
        workspaces = [merged]

for ws in workspaces:
    if ws.get("enabled") is False:
        continue
    name = (ws.get("name") or "workspace").replace("'", "'\\''")
    root = (ws.get("root") or "/workspace").replace("'", "'\\''")
    session = (ws.get("tmux_session") or ws.get("tmux") or name).replace("'", "'\\''")
    repos = ", ".join(
        (p.get("name") or p.get("alias") or "?") for p in (ws.get("projects") or [])
    )
    repos = repos.replace("'", "'\\''")
    print(f"{name}\t{root}\t{session}\t{repos}")
PY
)

    ((${#WS_NAMES[@]} > 0))
}

workspace_status() {
    local session="$1"
    if tmux has-session -t "=${session}" 2>/dev/null; then
        printf '[tmux live]'
    else
        printf '[new]'
    fi
}

print_menu() {
    local i
    clear 2>/dev/null || true
    printf 'cind workspaces\n'
    printf '────────────────────────────\n'
    if ((${#WS_NAMES[@]} == 0)); then
        printf '(no workspaces configured)\n'
        printf 'Add workspaces[] to cind.config.json\n'
    else
        for i in "${!WS_NAMES[@]}"; do
            printf ' %d) %-16s %s\n' "$((i + 1))" "${WS_NAMES[i]}" "$(workspace_status "${WS_SESSIONS[i]}")"
            printf '    %s\n' "${WS_ROOTS[i]}"
            if [[ -n "${WS_REPOS[i]}" ]]; then
                printf '    repos: %s\n' "${WS_REPOS[i]}"
            fi
        done
    fi
    printf '────────────────────────────\n'
    printf 'r) refresh\n'
    printf 'q) quit\n'
    printf '\n'
}

attach_workspace() {
    local index="$1"
    local name="${WS_NAMES[index]}"
    local root="${WS_ROOTS[index]}"
    local session="${WS_SESSIONS[index]}"

    if [[ ! -d "${root}" ]]; then
        printf 'Workspace root missing: %s\n' "${root}"
        sleep 2
        return 0
    fi
    cd "${root}"
    exec cursor-tmux-workspace-attach "${session}" "${root}" "${name}"
}

fallback_single_repo() {
    [[ -n "${PROJECT_DIR}" && -d "${PROJECT_DIR}" ]] || return 1
    local name
    name="$(basename "${PROJECT_DIR}")"
    exec cursor-tmux-workspace-attach "${name}" "${PROJECT_DIR}" "${name}"
}

main() {
    local choice index

    while true; do
        if ! load_workspaces; then
            fallback_single_repo
        fi
        print_menu

        if ! read -r -p 'Choose: ' choice; then
            printf '\n'
            exit 0
        fi

        case "${choice}" in
            q|Q) exit 0 ;;
            r|R|"") continue ;;
            *)
                if [[ "${choice}" =~ ^[0-9]+$ ]]; then
                    index=$((choice - 1))
                    if (( index >= 0 && index < ${#WS_NAMES[@]} )); then
                        attach_workspace "${index}"
                    else
                        printf 'Enter 1-%d, r, or q.\n' "${#WS_NAMES[@]}"
                        sleep 1
                    fi
                else
                    printf 'Enter 1-%d, r, or q.\n' "${#WS_NAMES[@]}"
                    sleep 1
                fi
                ;;
        esac
    done
}

main "$@"
