#!/usr/bin/env bash
# Start OpenSSH in the foreground for VPS / Tailscale access.
# Runs after docker-entrypoint (init-cursor-home). Requires sudo NOPASSWD.

set -Eeuo pipefail

PASSWORD="${DEVELOPER_PASSWORD:-cursor}"
USERNAME="${SSH_USERNAME:-developer}"

if [[ -z "${PASSWORD}" ]]; then
    printf 'Error: DEVELOPER_PASSWORD must not be empty\n' >&2
    exit 1
fi

sudo mkdir -p /run/sshd
sudo chmod 0755 /run/sshd
sudo ssh-keygen -A
printf '%s:%s\n' "${USERNAME}" "${PASSWORD}" | sudo chpasswd

printf 'SSH ready: user=%s port=22 (password from DEVELOPER_PASSWORD)\n' "${USERNAME}" >&2
exec sudo /usr/sbin/sshd -D -e
