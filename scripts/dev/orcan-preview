#!/usr/bin/env bash
# Run the Orcan UX from this checkout as an isolated Docker stack.
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
# This checkout has path parity with the host Docker daemon. Keep generated
# preview binds here (gitignored), never under the container's private /tmp.
PREVIEW_ROOT="${ORCAN_PREVIEW_ROOT:-${ROOT_DIR}/.orcan-dev-ux}"
PREVIEW_SETTINGS="${PREVIEW_ROOT}/settings.env"
REQUESTED_PORT="${ORCAN_PREVIEW_PORT:-}"
PORT_EXPLICIT=0
[[ -z "${REQUESTED_PORT}" ]] || PORT_EXPLICIT=1
REQUESTED_BIND="${ORCAN_PREVIEW_BIND:-}"
REQUESTED_SCENARIO="${ORCAN_PREVIEW_SCENARIO:-}"
SAVED_PORT=""
SAVED_BIND=""
SAVED_SCENARIO=""
if [[ -f "${PREVIEW_SETTINGS}" ]]; then
    while IFS='=' read -r key value || [[ -n "${key}${value}" ]]; do
        [[ -n "${key}" ]] || continue
        case "${key}" in
            ORCAN_PREVIEW_PORT) SAVED_PORT="${value}" ;;
            ORCAN_PREVIEW_BIND) SAVED_BIND="${value}" ;;
            ORCAN_PREVIEW_SCENARIO) SAVED_SCENARIO="${value}" ;;
            *) printf 'Error: unsupported key in %s: %s\n' "${PREVIEW_SETTINGS}" "${key}" >&2; exit 1 ;;
        esac
    done <"${PREVIEW_SETTINGS}"
fi
PREVIEW_HOME="${PREVIEW_ROOT}/home"
PREVIEW_DATA="${PREVIEW_ROOT}/data"
PREVIEW_IMAGE="${ORCAN_PREVIEW_IMAGE:-orcan:dev-ux}"
PREVIEW_PROJECT="${ORCAN_PREVIEW_PROJECT:-orcan-dev-ux}"
PREVIEW_INSTANCE="${ORCAN_PREVIEW_INSTANCE:-dev-ux}"
PREVIEW_PORT="${REQUESTED_PORT:-${SAVED_PORT:-17681}}"
PREVIEW_BIND="${REQUESTED_BIND:-${SAVED_BIND:-0.0.0.0}}"
PREVIEW_SCENARIO="${REQUESTED_SCENARIO:-${SAVED_SCENARIO:-busy}}"
PREVIEW_CONTAINER="orcan-${PREVIEW_INSTANCE}"
DOCKER_BIN="${ORCAN_PREVIEW_DOCKER:-docker}"

if [[ "${PREVIEW_PORT}" != "auto" && ! "${PREVIEW_PORT}" =~ ^[0-9]+$ ]]; then
    printf 'Error: invalid persisted preview port: %s\n' "${PREVIEW_PORT}" >&2
    exit 1
fi
if [[ "${PREVIEW_BIND}" != "0.0.0.0" && "${PREVIEW_BIND}" != "127.0.0.1" ]]; then
    printf 'Error: invalid persisted preview bind: %s\n' "${PREVIEW_BIND}" >&2
    exit 1
fi

usage() {
    cat <<'EOF'
Usage: scripts/dev/orcan-preview COMMAND [OPTIONS]

Run the complete developer browser UX from the current checkout without using the
installed Orcan config, image tag, container, tmux server, or agent data.

Commands:
  start [--port PORT|auto]       start; build only when the image is missing
  restart [--port PORT|auto]     refresh current cockpit source and recreate
  rebuild [--no-cache]           explicit image rebuild, then recreate
  stop                            stop the preview stack (keep image/cache)
  status                         show preview container, image, and URL
  url                            print the preview URL
  logs                           follow preview container logs
  enter                          enter the isolated developer launcher
  shell                          open zsh in the preview container
  checklist                      print the manual UX checklist
  doctor                         verify Docker, isolation, health, and HTTP
  smoke                          exercise Textual cockpit and embedded tmux PTY
  reset                          stop and remove disposable preview state
  check                          validate generated isolation config; no Docker

Environment overrides:
  ORCAN_PREVIEW_ROOT, ORCAN_PREVIEW_IMAGE, ORCAN_PREVIEW_PORT, ORCAN_PREVIEW_BIND
  ORCAN_PREVIEW_PROJECT, ORCAN_PREVIEW_INSTANCE, ORCAN_PREVIEW_SCENARIO

This is development/test infrastructure, not the public Orcan CLI.
The default preview URL is http://127.0.0.1:17681.
EOF
}

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
have_command() {
    if [[ "$1" == */* ]]; then [[ -x "$1" ]]; else command -v "$1" >/dev/null 2>&1; fi
}
require_command() { have_command "$1" || die "$1 is required"; }

validate_value() {
    [[ "$2" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || die "invalid $1: $2"
}

validate_port() {
    [[ "${PREVIEW_PORT}" != "auto" ]] || return 0
    if [[ ! "${PREVIEW_PORT}" =~ ^[0-9]+$ ]] \
        || (( PREVIEW_PORT < 1024 || PREVIEW_PORT > 65535 )); then
        die "invalid preview port: ${PREVIEW_PORT} (expected 1024-65535)"
    fi
}

port_available() {
    python3 - "${PREVIEW_BIND}" "$1" <<'PY'
import socket, sys
host, port = sys.argv[1], int(sys.argv[2])
with socket.socket() as sock:
    try:
        sock.bind((host, port))
    except OSError:
        raise SystemExit(1)
PY
}

resolve_preview_port() {
    require_command python3
    if preview_container_exists; then
        assert_preview_container
        [[ "${PREVIEW_PORT}" != "auto" ]] || die "--port auto cannot be used while preview is running"
        return 0
    fi
    local candidate="${PREVIEW_PORT}" original
    [[ "${candidate}" != "auto" ]] || candidate=17681
    original="${candidate}"
    if port_available "${candidate}"; then
        PREVIEW_PORT="${candidate}"
        return 0
    fi
    if (( PORT_EXPLICIT )); then
        die "preview port ${candidate} is already in use"
    fi
    for (( candidate=original + 1; candidate<=original + 100 && candidate<=65535; candidate++ )); do
        if port_available "${candidate}"; then
            PREVIEW_PORT="${candidate}"
            printf 'Port %s is busy; selected %s for developer UX.\n' "${original}" "${PREVIEW_PORT}"
            return 0
        fi
    done
    die "no free developer UX port found after ${original}"
}

validate_bind() {
    [[ "${PREVIEW_BIND}" == "0.0.0.0" || "${PREVIEW_BIND}" == "127.0.0.1" ]] \
        || die "invalid preview bind: ${PREVIEW_BIND} (expected 0.0.0.0 or 127.0.0.1)"
}

validate_scenario() {
    case "${PREVIEW_SCENARIO}" in empty|busy|errors|long-names) return 0 ;; esac
    die "invalid preview scenario: ${PREVIEW_SCENARIO} (expected empty, busy, errors, or long-names)"
}

assert_isolation() {
    validate_value "Compose project" "${PREVIEW_PROJECT}"
    validate_value "container instance" "${PREVIEW_INSTANCE}"
    validate_port
    validate_bind
    validate_scenario
    [[ "${PREVIEW_PROJECT}" != "orcan" ]] || die "preview Compose project must not be 'orcan'"
    [[ "${PREVIEW_INSTANCE}" != "1" ]] || die "preview instance must not use orcan-1"
    [[ "${PREVIEW_IMAGE}" != "orcan:latest" ]] || die "preview image must not use orcan:latest"
    [[ "${PREVIEW_PORT}" != "7681" ]] || die "preview must not use the default ttyd port 7681"
    [[ "${PREVIEW_HOME}" != "${HOME}/.config/orcan" ]] || die "preview must not use the normal ORCAN_HOME"
}

write_fixture() {
    require_command python3
    assert_isolation
    mkdir -p "${PREVIEW_HOME}" "${PREVIEW_DATA}"
    python3 - "${PREVIEW_HOME}/orcan.config.json" "${ROOT_DIR}" "${PREVIEW_PORT}" "${PREVIEW_BIND}" <<'PY'
import json
import sys
from pathlib import Path

target, checkout, port, bind = sys.argv[1:]
config = {
    "workspaces": [{"name": "dev-ux", "projects": [{"name": "orcan", "path": checkout}]}],
    "tmux": {"initial_windows": 3, "window_prefix": "preview"},
    "ttyd": {
        "port": 7681, "host_port": int(port), "bind": bind,
        "font_size": 19, "theme": "dark", "ping_interval": 20,
    },
    "resources": {"cpus": 2, "memory": "4g", "shm_size": "512m", "tmpfs_size": "512m"},
}
Path(target).write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
PY
    cat >"${PREVIEW_HOME}/.env" <<EOF
ORCAN_DATA=${PREVIEW_DATA}
ORCAN_PROJECTS_ROOT=${PREVIEW_DATA}/sandbox
COMPOSE_PROJECT_NAME=${PREVIEW_PROJECT}
ORCAN_INSTANCE=${PREVIEW_INSTANCE}
IMAGE_LOCAL=${PREVIEW_IMAGE}
TTYD_PORT=7681
TTYD_HOST_PORT=${PREVIEW_PORT}
TTYD_BIND=${PREVIEW_BIND}
EOF
}

preview_orcan() {
    ORCAN_HOME="${PREVIEW_HOME}" ORCAN_DATA="${PREVIEW_DATA}" \
    ORCAN_CONFIG_FILE="${PREVIEW_HOME}/orcan.config.json" "${ROOT_DIR}/bin/orcan" "$@"
}

compose_preview() {
    # Shell variables inherited from the active self-development container
    # override Compose --env-file values. Start Compose with a clean process
    # environment so e.g. its CONTAINER_PROJECT_DIR cannot leak into preview.
    env -i PATH="${PATH}" HOME="${HOME}" "${DOCKER_BIN}" compose --project-name "${PREVIEW_PROJECT}" \
        --env-file "${PREVIEW_HOME}/.env" --project-directory "${ROOT_DIR}" \
        -f "${ROOT_DIR}/docker-compose.yml" \
        -f "${PREVIEW_HOME}/mounts/compose-projects.generated.yml" \
        -f "${PREVIEW_HOME}/compose-source.generated.yml" \
        -f "${ROOT_DIR}/docker-compose.ttyd.yml" "$@"
}

assert_preview_container() {
    "${DOCKER_BIN}" inspect "${PREVIEW_CONTAINER}" >/dev/null 2>&1 || return 1
    local project
    project="$("${DOCKER_BIN}" inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "${PREVIEW_CONTAINER}")"
    [[ "${project}" == "${PREVIEW_PROJECT}" ]] \
        || die "refusing to touch ${PREVIEW_CONTAINER}: Compose project is ${project}, expected ${PREVIEW_PROJECT}"
}

preview_container_exists() {
    "${DOCKER_BIN}" inspect "${PREVIEW_CONTAINER}" >/dev/null 2>&1
}

sync_fixture() {
    write_fixture
    local setup_log="${PREVIEW_ROOT}/setup.log"
    : >"${setup_log}"
    if ! CONFIG="${PREVIEW_HOME}/orcan.config.json" PROJECT_DIR="${PREVIEW_HOME}" \
        ORCAN_HOME="${PREVIEW_HOME}" ORCAN_ROOT="${ROOT_DIR}" ORCAN_DATA="${PREVIEW_DATA}" \
        ORCAN_PROJECTS_ROOT="${PREVIEW_DATA}/sandbox" \
            "${ROOT_DIR}/scripts/repository/update-env.sh" >>"${setup_log}" 2>&1; then
        tail -n 30 "${setup_log}" >&2
        die "could not prepare the developer UX fixture (full log: ${setup_log})"
    fi
    if ! ORCAN_HOME="${PREVIEW_HOME}" ORCAN_DATA="${PREVIEW_DATA}" \
        ORCAN_PROJECTS_ROOT="${PREVIEW_DATA}/sandbox" \
        "${ROOT_DIR}/scripts/repository/python.sh" \
            "${ROOT_DIR}/scripts/repository/compile_context.py" "${PREVIEW_HOME}" \
            >>"${setup_log}" 2>&1; then
        tail -n 30 "${setup_log}" >&2
        die "could not compile preview context (full log: ${setup_log})"
    fi
    cat >"${PREVIEW_HOME}/compose-source.generated.yml" <<EOF
# Generated developer override: run cockpit Python directly from this checkout.
services:
  orcan:
    environment:
      PYTHONPATH: ${ROOT_DIR}/cockpit/src:/usr/local/lib
EOF
    local inbox="${PREVIEW_HOME}/workspaces/dev-ux/.orcan/context-inbox"
    mkdir -p "${inbox}"
    rm -f -- "${inbox}"/preview-*.json
    [[ "${PREVIEW_SCENARIO}" != "empty" ]] || return 0
    cat >"${inbox}/preview-navigation.json" <<'EOF'
{"project_name":"orcan","title":"Preview: navigation convention","content":"Keep the workspace picker keyboard-first.","justification":"Fixture used to exercise the cockpit review panel."}
EOF
    cat >"${inbox}/preview-testing.json" <<'EOF'
{"project_name":"orcan","title":"Preview: testing convention","content":"Verify focus switching between the terminal and side panel.","justification":"Fixture used to exercise count and review actions."}
EOF
    if [[ "${PREVIEW_SCENARIO}" == "busy" ]]; then
        local number
        for number in 3 4 5 6 7 8; do
            printf '{"project_name":"orcan","title":"Preview item %s","content":"Dense fixture row %s for scrolling and review.","justification":"Developer UX busy-state fixture."}\n' \
                "${number}" "${number}" >"${inbox}/preview-busy-${number}.json"
        done
    elif [[ "${PREVIEW_SCENARIO}" == "errors" ]]; then
        printf '{"project_name":"missing-project","title":"Preview: unavailable project","content":"Exercise an unavailable target.","justification":"Developer UX error-state fixture."}\n' \
            >"${inbox}/preview-error.json"
    elif [[ "${PREVIEW_SCENARIO}" == "long-names" ]]; then
        printf '{"project_name":"orcan","title":"Preview: an intentionally very long assertion title that must remain readable without breaking the side panel","content":"An intentionally long body used to verify wrapping, clipping, scrolling, and focus behavior in constrained browser sizes.","justification":"Developer UX long-content fixture."}\n' \
            >"${inbox}/preview-long-names.json"
    fi
}

build_image() {
    local args=(build --tag "${PREVIEW_IMAGE}")
    local commit dirty
    commit="$(git -C "${ROOT_DIR}" rev-parse --short HEAD 2>/dev/null || printf unknown)"
    dirty=false
    [[ -z "$(git -C "${ROOT_DIR}" status --porcelain --untracked-files=normal 2>/dev/null)" ]] || dirty=true
    [[ "${1:-0}" == 1 ]] && args+=(--no-cache)
    args+=(
        --build-arg "USER_UID=$(id -u)" --build-arg "USER_GID=$(id -g)"
        --build-arg INSTALL_CURSOR=0 --build-arg INSTALL_CLAUDE=0
        --build-arg INSTALL_CODEX=1 --build-arg ORCAN_VERSION=dev-ux
        --label "dev.orcan.preview.commit=${commit}" --label "dev.orcan.preview.dirty=${dirty}"
        "${ROOT_DIR}"
    )
    printf 'Building isolated UX image %s from %s\n' "${PREVIEW_IMAGE}" "${ROOT_DIR}"
    "${DOCKER_BIN}" "${args[@]}"
}

preview_url() { printf 'http://127.0.0.1:%s\n' "${PREVIEW_PORT}"; }

write_settings() {
    mkdir -p "${PREVIEW_ROOT}"
    printf 'ORCAN_PREVIEW_PORT=%s\nORCAN_PREVIEW_BIND=%s\nORCAN_PREVIEW_SCENARIO=%s\n' \
        "${PREVIEW_PORT}" "${PREVIEW_BIND}" "${PREVIEW_SCENARIO}" >"${PREVIEW_SETTINGS}"
}

acquire_operation_lock() {
    mkdir -p "${PREVIEW_ROOT}"
    local lock="${PREVIEW_ROOT}/operation.lock"
    if ! mkdir "${lock}" 2>/dev/null; then
        local owner_pid=""
        [[ ! -f "${lock}/owner" ]] || read -r owner_pid _ <"${lock}/owner"
        if [[ "${owner_pid}" =~ ^[0-9]+$ ]] && ! kill -0 "${owner_pid}" 2>/dev/null; then
            rm -f -- "${lock}/owner"
            rmdir -- "${lock}" 2>/dev/null || die "cannot clear stale preview lock: ${lock}"
            mkdir "${lock}" || die "cannot acquire preview operation lock: ${lock}"
        else
            die "another preview operation is active (lock: ${lock})"
        fi
    fi
    printf '%s %s\n' "$$" "$1" >"${lock}/owner"
    trap 'rm -f -- "${PREVIEW_ROOT}/operation.lock/owner"; rmdir -- "${PREVIEW_ROOT}/operation.lock" 2>/dev/null || true' EXIT
}

parse_runtime_options() {
    while (( $# )); do
        case "$1" in
            --port) [[ $# -ge 2 ]] || die "--port requires a value"; PREVIEW_PORT="$2"; PORT_EXPLICIT=1; shift ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done
    assert_isolation
    resolve_preview_port
    assert_isolation
    write_settings
}

container_health() {
    "${DOCKER_BIN}" inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
        "${PREVIEW_CONTAINER}" 2>/dev/null || printf 'stopped\n'
}

wait_until_ready() {
    local health="starting"
    for _ in {1..30}; do
        health="$(container_health)"
        [[ "${health}" == "healthy" ]] && break
        [[ "${health}" == "unhealthy" || "${health}" == "exited" ]] && break
        sleep 2
    done
    if [[ "${health}" != "healthy" ]]; then
        printf 'Preview did not become healthy (state: %s). Recent logs:\n' "${health}" >&2
        "${DOCKER_BIN}" logs --tail 30 "${PREVIEW_CONTAINER}" >&2 || true
        return 1
    fi
}

print_ready() {
    local commit dirty
    commit="$("${DOCKER_BIN}" image inspect --format '{{index .Config.Labels "dev.orcan.preview.commit"}}' "${PREVIEW_IMAGE}" 2>/dev/null || true)"
    dirty="$("${DOCKER_BIN}" image inspect --format '{{index .Config.Labels "dev.orcan.preview.dirty"}}' "${PREVIEW_IMAGE}" 2>/dev/null || true)"
    printf '\nOrcan developer UX environment is ready\n'
    printf '  State: healthy\n'
    printf '  Local: %s\n' "$(preview_url)"
    printf '  Fixture: %s\n' "${PREVIEW_SCENARIO}"
    [[ -z "${commit}" ]] || printf '  Source: %s (dirty=%s)\n' "${commit}" "${dirty:-unknown}"
    if [[ "${PREVIEW_BIND}" == "0.0.0.0" ]]; then
        printf '  LAN:   http://<host-ip>:%s\n' "${PREVIEW_PORT}"
    fi
    printf '\nAfter UX changes: make dev-restart\n'
    printf 'Stop:              make dev-stop\n'
}

cmd_start() {
    parse_runtime_options "$@"
    require_command "${DOCKER_BIN}"
    printf 'Preparing Orcan developer UX environment…\n'
    sync_fixture
    if ! "${DOCKER_BIN}" image inspect "${PREVIEW_IMAGE}" >/dev/null 2>&1; then
        printf 'Preview image is missing; running the first build.\n'
        build_image 0
    fi
    compose_preview up -d
    wait_until_ready
    print_ready
}

cmd_restart() {
    parse_runtime_options "$@"
    require_command "${DOCKER_BIN}"
    printf 'Refreshing current UX source and restarting preview…\n'
    sync_fixture
    compose_preview up -d --force-recreate
    wait_until_ready
    print_ready
}

cmd_rebuild() {
    local no_cache=0
    while (( $# )); do
        case "$1" in
            --no-cache) no_cache=1 ;;
            *) die "unknown rebuild option: $1" ;;
        esac
        shift
    done
    assert_isolation
    write_settings
    require_command "${DOCKER_BIN}"
    sync_fixture
    build_image "${no_cache}"
    compose_preview up -d --force-recreate
    wait_until_ready
    print_ready
}

cmd_status() {
    local health="stopped"
    if have_command "${DOCKER_BIN}" && preview_container_exists; then
        assert_preview_container
        health="$(container_health)"
    fi
    printf 'Orcan developer UX environment\n\n'
    printf 'State:     %s\nContainer: %s\nImage:     %s\nFixture:   %s\nBind:      %s:%s\n' \
        "${health}" "${PREVIEW_CONTAINER}" "${PREVIEW_IMAGE}" "${PREVIEW_SCENARIO}" "${PREVIEW_BIND}" "${PREVIEW_PORT}"
    printf 'Local:     %s\n' "$(preview_url)"
    [[ "${PREVIEW_BIND}" != "0.0.0.0" ]] || printf 'LAN:       http://<host-ip>:%s\n' "${PREVIEW_PORT}"
}

cmd_doctor() {
    local failures=0
    printf 'Orcan developer UX doctor\n\n'
    if have_command "${DOCKER_BIN}" && "${DOCKER_BIN}" info >/dev/null 2>&1; then
        printf '[OK] Docker daemon\n'
    else
        printf '[FAIL] Docker daemon unavailable\n'; failures=$((failures + 1))
    fi
    if preview_container_exists; then
        if assert_preview_container; then printf '[OK] isolated Compose identity\n'; fi
        if [[ "$(container_health)" == "healthy" ]]; then
            printf '[OK] container healthy\n'
        else
            printf '[FAIL] container is not healthy\n'; failures=$((failures + 1))
        fi
        if "${DOCKER_BIN}" exec "${PREVIEW_CONTAINER}" curl -fsS http://127.0.0.1:7681/ >/dev/null 2>&1; then
            printf '[OK] ttyd HTTP responds inside container\n'
        else
            printf '[FAIL] ttyd HTTP does not respond\n'; failures=$((failures + 1))
        fi
        if "${DOCKER_BIN}" exec "${PREVIEW_CONTAINER}" test -f \
            "${ROOT_DIR}/scripts/dev/orcan-preview"; then
            printf '[OK] checkout bind is readable inside preview\n'
        else
            printf '[FAIL] checkout bind is not readable inside preview\n'; failures=$((failures + 1))
        fi
        local cockpit_source
        cockpit_source="$("${DOCKER_BIN}" exec "${PREVIEW_CONTAINER}" \
            /opt/orcan-cockpit/venv/bin/python3 -c \
            'import inspect, orcan_cockpit; print(inspect.getfile(orcan_cockpit))' 2>/dev/null || true)"
        if [[ "${cockpit_source}" == "${ROOT_DIR}"/cockpit/src/* ]]; then
            printf '[OK] cockpit runs directly from checkout source\n'
        else
            printf '[FAIL] cockpit does not use checkout source (%s)\n' "${cockpit_source:-unknown}"
            failures=$((failures + 1))
        fi
    else
        printf '[FAIL] preview container is stopped\n'; failures=$((failures + 1))
    fi
    [[ -f "${PREVIEW_HOME}/orcan.config.json" ]] && printf '[OK] isolated fixture config\n' \
        || { printf '[FAIL] fixture config missing\n'; failures=$((failures + 1)); }
    (( failures == 0 )) || die "doctor found ${failures} problem(s)"
}

cmd_smoke() {
    require_command "${DOCKER_BIN}"
    assert_preview_container || die "developer UX container is not running"
    [[ "$(container_health)" == "healthy" ]] || die "developer UX container is not healthy"
    "${DOCKER_BIN}" exec \
        -e PYTHONPATH="${ROOT_DIR}/cockpit/src:/usr/local/lib" \
        "${PREVIEW_CONTAINER}" \
        /opt/orcan-cockpit/venv/bin/python3 \
        "${ROOT_DIR}/tests/smoke/test-cockpit-tui.py"
}

cmd_stop() {
    require_command "${DOCKER_BIN}"
    if assert_preview_container; then
        if [[ -f "${PREVIEW_HOME}/.env" \
            && -f "${PREVIEW_HOME}/mounts/compose-projects.generated.yml" \
            && -f "${PREVIEW_HOME}/compose-source.generated.yml" ]]; then
            compose_preview down --remove-orphans
        else
            printf 'Preview state is incomplete; stopping the verified container directly.\n'
            "${DOCKER_BIN}" stop "${PREVIEW_CONTAINER}" >/dev/null
            "${DOCKER_BIN}" rm "${PREVIEW_CONTAINER}" >/dev/null
        fi
        printf 'Orcan developer UX environment stopped. Image and build cache were kept.\n'
    else
        printf 'Orcan developer UX environment is already stopped.\n'
    fi
}

cmd_checklist() {
    cat <<'EOF'
Manual UX checks:
  Before merge (automated):
    [ ] make dev-doctor
    [ ] make dev-smoke
    [ ] make dev-a11y
    [ ] make dev-visual
    [ ] make dev-test
  Browser/manual flow:
  [ ] left workspace list is readable
  [ ] Enter attaches the selected workspace (center column)
  [ ] F2 toggles the left-column ASSERTIONS section
  [ ] F4 / ‹› edge toggle hides the left workspaces column
  [ ] with ASSERTIONS focused: r runs context review; p pauses automation; o turns automation off/on
  [ ] F1 opens the shortcuts overlay with About (from terminal focus — ? is typed into the shell)
  [ ] i expands workspace details on the list (root + repos)
  [ ] lg in the terminal opens lazygit (no cockpit F3)
  [ ] terminal receives typing and Ctrl+Space
  [ ] Alt+1..9 switches tmux windows (not typed digits)
  [ ] resizing the browser redraws tmux (not stuck at attach size)
  [ ] pending assertions match the active scenario
  [ ] review action opens in the correct session
  [ ] browser refresh preserves the tmux session
  [ ] compact viewport (900x700) has no clipping or horizontal scroll
  [ ] tiny viewport (480x320) keeps the terminal usable
  [ ] Tab reaches the terminal and focus remains visible
  [ ] no serious/critical axe accessibility violations
EOF
}

cmd_reset() {
    require_command "${DOCKER_BIN}"
    cmd_stop
    local resolved default_resolved
    resolved="$(cd -- "$(dirname "${PREVIEW_ROOT}")" && pwd -P)/$(basename "${PREVIEW_ROOT}")"
    default_resolved="${ROOT_DIR}/.orcan-dev-ux"
    [[ "${resolved}" == "${default_resolved}" ]] \
        || die "reset is allowed only for the default preview state: ${default_resolved}"
    rm -rf -- "${resolved}"
    printf 'Removed disposable preview state: %s\n' "${resolved}"
}

cmd_check() {
    write_fixture
    python3 - "${PREVIEW_HOME}/orcan.config.json" "${PREVIEW_HOME}/.env" "${ROOT_DIR}" \
        "${PREVIEW_PROJECT}" "${PREVIEW_INSTANCE}" "${PREVIEW_IMAGE}" "${PREVIEW_PORT}" <<'PY'
import json
import sys
from pathlib import Path

config_path, env_path, checkout = map(Path, sys.argv[1:4])
project, instance, image, port = sys.argv[4:]
config = json.loads(config_path.read_text(encoding="utf-8"))
assert config["workspaces"][0]["projects"][0]["path"] == str(checkout)
assert config["ttyd"]["bind"] in ("0.0.0.0", "127.0.0.1")
env = env_path.read_text(encoding="utf-8")
for expected in (f"COMPOSE_PROJECT_NAME={project}", f"ORCAN_INSTANCE={instance}", f"IMAGE_LOCAL={image}", f"TTYD_HOST_PORT={port}"):
    assert expected in env, expected
print("Orcan developer UX isolation check OK")
PY
}

command="${1:-help}"
shift || true
case "${command}" in start|restart|rebuild|stop|reset) acquire_operation_lock "${command}" ;; esac
case "${command}" in
    start) cmd_start "$@" ;;
    restart) cmd_restart "$@" ;;
    rebuild) cmd_rebuild "$@" ;;
    status) cmd_status ;;
    url) preview_url ;;
    logs) require_command "${DOCKER_BIN}"; assert_preview_container || die "developer UX container is not running"; "${DOCKER_BIN}" logs -f "${PREVIEW_CONTAINER}" ;;
    enter) require_command "${DOCKER_BIN}"; assert_preview_container || die "developer container is not running"; preview_orcan enter ;;
    shell) require_command "${DOCKER_BIN}"; assert_preview_container || die "developer container is not running"; preview_orcan enter --shell ;;
    checklist) cmd_checklist ;;
    doctor) cmd_doctor ;;
    smoke) cmd_smoke ;;
    stop) cmd_stop ;;
    reset) cmd_reset ;;
    check) cmd_check ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: ${command}" ;;
esac
