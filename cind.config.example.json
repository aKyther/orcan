{
  "workspaces": [
    {
      "name": "gotibooks",
      "mount_mode": "parity",
      "meta_path": "/absolute/path/to/gotibooks-workspace",
      "tmux": "gotibooks",
      "projects": [
        {
          "name": "backend",
          "path": "/absolute/path/to/gotibooks/backend",
          "role": "service",
          "windows": [
            {"name": "editor", "icon": "📝", "dir": "."},
            {"name": "server", "icon": "🐍", "dir": ".", "command": "bash"},
            {"name": "logs", "icon": "⚙", "dir": "."}
          ]
        },
        {
          "name": "frontend",
          "path": "/absolute/path/to/gotibooks/frontend",
          "role": "service"
        },
        {
          "name": "agent",
          "path": "/absolute/path/to/gotibooks/agent",
          "role": "orchestrator"
        }
      ]
    },
    {
      "name": "code-review",
      "mount_mode": "workspace",
      "tmux": "review",
      "projects": [
        {
          "name": "upstream",
          "path": "/absolute/path/to/upstream-repo",
          "role": "repo"
        }
      ]
    },
    {
      "name": "cind",
      "mount_mode": "parity",
      "projects": [
        {
          "name": "cind",
          "path": "/absolute/path/to/cind",
          "role": "orchestrator"
        }
      ]
    }
  ],
  "tmux": {
    "mode": "windows-by-repo"
  },
  "ttyd": {
    "port": 7681,
    "host_port": 7681,
    "font_size": 22
  },
  "resources": {
    "cpus": 8,
    "memory": "16g",
    "shm_size": "2g",
    "tmpfs_size": "2g"
  }
}
