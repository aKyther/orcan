{
  "workspaces": [
    {
      "name": "gotibooks",
      "tmux": "gotibooks",
      "projects": [
        {
          "name": "backend",
          "path": "/absolute/path/to/gotibooks/backend"
        },
        {
          "name": "frontend",
          "path": "/absolute/path/to/gotibooks/frontend"
        },
        {
          "name": "agent",
          "path": "/absolute/path/to/gotibooks/agent"
        }
      ]
    },
    {
      "name": "cind",
      "projects": [
        {
          "name": "cind",
          "path": "/absolute/path/to/cind"
        }
      ]
    }
  ],
  "tmux": {
    "initial_windows": 3,
    "window_prefix": "workspace"
  },
  "ttyd": {
    "port": 7681,
    "host_port": 7681,
    "font_size": 22
  },
  "resources": {
    "cpus": 8,
    "memory": "16g",
    "shm_size": "2g",
    "tmpfs_size": "2g"
  }
}
