{
  "_comment": "Copy to orcan.config.json and edit absolute paths. Then: make env",
  "workspaces": [
    {
      "name": "gotibooks",
      "projects": [
        {
          "name": "backend",
          "path": "/absolute/path/to/gotibooks/backend"
        },
        {
          "name": "frontend",
          "path": "/absolute/path/to/gotibooks/frontend"
        },
        {
          "name": "agent",
          "path": "/absolute/path/to/gotibooks/agent"
        }
      ]
    },
    {
      "name": "orcan",
      "projects": [
        {
          "name": "orcan",
          "path": "/absolute/path/to/orcan"
        }
      ]
    }
  ],
  "tmux": {
    "initial_windows": 3,
    "window_prefix": "tab"
  },
  "ttyd": {
    "port": 7681,
    "host_port": 7681,
    "font_size": 19,
    "font_family": "Menlo, Monaco, 'Courier New', monospace",
    "theme": "dark",
    "ping_interval": 20
  },
  "resources": {
    "cpus": 2,
    "memory": "4g",
    "shm_size": "512m",
    "tmpfs_size": "512m"
  }
}
