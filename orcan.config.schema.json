{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aKyther/orcan/main/orcan.config.schema.json",
  "title": "Orcan host configuration",
  "description": "Schema for orcan.config.json. Enforced in practice by scripts/repository/apply-config.py.",
  "type": "object",
  "additionalProperties": true,
  "required": ["workspaces"],
  "properties": {
    "host_id": { "type": "string", "format": "uuid", "description": "Registered Orcan host installation UUID." },
    "container_id": { "type": "string", "format": "uuid", "description": "Registered logical container configuration UUID; explicit replacement creates a new ID." },
    "identity": {
      "description": "Frozen identity selected at container creation; all workspaces inherit its instructions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "description",
        "instructions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "enum": [
                  "cursor",
                  "claude",
                  "codex",
                  "gemini",
                  "copilot"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "cursor",
                      "claude",
                      "codex",
                      "gemini",
                      "copilot"
                    ]
                  },
                  "version": {
                    "type": "string"
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "enum": [
                          "npm",
                          "installer",
                          "archive"
                        ]
                      },
                      "package": {
                        "type": "string"
                      },
                      "registry": {
                        "type": "string",
                        "format": "uri"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-fA-F0-9]{64}$"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "oneOf": [
              {
                "enum": [
                  "go",
                  "rust"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "go",
                      "rust"
                    ]
                  },
                  "version": {
                    "type": "string"
                  },
                  "cockpit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pty_read_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        },
        "pty_read_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "pty_chunk_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 65536
        },
        "peek_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 8192
        }
      }
    },
    "image": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "image": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$",
      "description": "Installed Docker image chosen at container creation; normal sync preserves host overrides."
    },
    "projects_root": {
      "type": "string",
      "pattern": "^/[^\\r\\n]*$",
      "description": "Shared host source catalog chosen at creation; defaults to the data root sandbox."
    },
    "_comment": {
      "type": "string",
      "description": "Optional human note; ignored by apply-config."
    },
    "workspaces": {
      "type": "array",
      "description": "May be empty while preparing a container before adding context.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "projects"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "tmux session name and /home/developer/workspaces/<name>"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "projects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "path"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Symlink name under the workspace root"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Absolute host path (path-parity mount)"
                }
              }
            }
          }
        }
      }
    },
    "tmux": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "history_limit": {"type":"integer","minimum":1000,"maximum":200000,"default":20000},
        "initial_windows": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "window_prefix": {
          "type": "string",
          "default": "tab"
        }
      }
    },
    "ttyd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 7681 },
        "host_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bind": {
          "type": "string",
          "default": "0.0.0.0",
          "description": "Host address for published ttyd port (TTYD_BIND). Default all interfaces; set 127.0.0.1 for loopback-only. Prefer Tailscale/VPN and TTYD_CREDENTIAL when reachable from a network."
        },
        "font_size": {
          "type": "integer",
          "minimum": 8,
          "default": 14,
          "description": "Desktop terminal font size. Phone and tablet widths use responsive 16 px and 14 px overrides."
        },
        "font_family": { "type": "string" },
        "renderer": {
          "type": "string",
          "enum": ["webgl", "canvas"],
          "default": "webgl",
          "description": "xterm.js renderer. WebGL is fastest; canvas is a compatibility fallback for browser/GPU rendering issues."
        },
        "theme": {
          "type": "string",
          "default": "dark",
          "description": "ttyd xterm.js theme preset (dark|navy, mocha) or raw JSON object (TTYD_THEME)"
        },
        "ping_interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 20,
          "description": "ttyd WebSocket ping interval in seconds (TTYD_PING_INTERVAL)"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpus": { "type": ["integer", "number", "string"], "default": 2 },
        "memory": { "type": "string", "default": "4g" },
        "shm_size": { "type": "string", "default": "512m" },
        "tmpfs_size": { "type": "string", "default": "512m" }
      }
    }
  }
}
