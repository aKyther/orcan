# Host user mapping (make env fills these from the host)
USER_UID=1000
USER_GID=1000

# Docker socket group on the host (used only by terminal-docker)
DOCKER_GID=999

# Timezone — make env copies the host zone (e.g. Europe/Warsaw). Compose also
# bind-mounts /etc/localtime. Override here only if you want a different TZ.
# TZ=Europe/Warsaw

# orcan repo on host (where you run make). NOT the agent/tmux start directory.
# Agent starts in CONTAINER_PROJECT_DIR / WORKSPACE_ROOT (see make path-check).
# Multi-workspace setups: use orcan.config.json (see orcan.config.example.json).
PROJECT_DIR=/absolute/path/to/orcan

# Generated by make env — default workspace root inside the container
# CONTAINER_PROJECT_DIR=/home/developer/workspaces/my-workspace

# Generated by make env (do not edit by hand unless needed)
# ORCAN_CONFIG_HOST=./.orcan/runtime-config.json
# ORCAN_CONFIG=/etc/orcan/config.json
# ORCAN_COMPOSE_PROJECTS=./.orcan/compose-projects.generated.yml

# Resource limits (host-specific — make env does NOT overwrite once set).
# Defaults match orcan.config.example.json / apply-config.py.
CPUS=8
MEMORY=16g
SHM_SIZE=2g
TMPFS_SIZE=2g

# Browser terminal (make terminal / make terminal-docker).
# WARNING: ttyd has no authentication. Use only on localhost or Tailscale (private tailnet).
# Do not expose this port to the public Internet without auth and TLS.
TTYD_PORT=7681
TTYD_HOST_PORT=7681
# Browser terminal font size (xterm.js). Edit .env — make env does not overwrite once set.
TTYD_FONT_SIZE=22
# Optional font / theme (defaults applied in cursor-ttyd if unset). Quote if commas.
# TTYD_FONT_FAMILY="Menlo, Monaco, 'Courier New', monospace"
TTYD_THEME=dark

# Host data root — always used (like poetry under ~/.config/pypoetry).
# make env creates this tree and writes the absolute path below.
# Override only if you need a non-default location:
ORCAN_DATA=

# Optional: which image Compose runs (default orcan:latest = Claude + Cursor)
# IMAGE_LOCAL=orcan:latest
# IMAGE_LOCAL=orcan:claude
# Build args (used by make build / make build-claude):
# INSTALL_CURSOR=1

# Optional: push a locally built image to a private registry (not used by CI releases)
# IMAGE_LOCAL=orcan:latest
# IMAGE_REGISTRY=registry.example.com
# IMAGE_REPOSITORY=mygroup/orcan
# IMAGE_TAG=0.1.0
#   IMAGE_LOCAL=orcan:claude IMAGE_TAG=0.1.0-claude make publish
# Do not commit tokens. For login use:
#   make registry-login
# or non-interactive:
#   REGISTRY_USER=myuser REGISTRY_PASSWORD=... make registry-login
# Preferred release path: make bump-patch → commit → make release (GitHub Release only)

