# Host user mapping (make env fills these from the host)
USER_UID=1000
USER_GID=1000

# Docker socket group on the host (used only by *-docker targets)
DOCKER_GID=999

# Absolute host path to the project (same path inside the container for path parity).
# Do not use ., ../project, or ~/project — Compose does not expand ~ reliably.
PROJECT_DIR=/absolute/path/to/your/project

# Resource limits
CPUS=8
MEMORY=16g
SHM_SIZE=2g
TMPFS_SIZE=2g

# SSH overlay (make shell / make shell-docker). Weak password — use only behind Tailscale.
SSH_HOST_PORT=22
DEVELOPER_PASSWORD=cursor
