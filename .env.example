# Host user mapping (make env fills these from the host)
USER_UID=1000
USER_GID=1000

# Docker socket group on the host (used only by terminal-docker)
DOCKER_GID=999

# cind repo on host (where you run make). NOT the agent/tmux start directory.
# Agent starts in CONTAINER_PROJECT_DIR / WORKSPACE_ROOT (see make path-check).
# Multi-workspace setups: use cind.config.json (see cind.config.example.json).
PROJECT_DIR=/absolute/path/to/cind

# Generated by make env — default workspace root inside the container
# CONTAINER_PROJECT_DIR=/home/developer/workspaces/my-workspace

# Generated by make env (do not edit by hand unless needed)
# CIND_CONFIG_HOST=./.cind/runtime-config.json
# CIND_CONFIG=/etc/cind/config.json
# CIND_COMPOSE_PROJECTS=./.cind/compose-projects.generated.yml

# Resource limits (host-specific — make env does NOT overwrite once set)
CPUS=8
MEMORY=16g
SHM_SIZE=2g
TMPFS_SIZE=2g

# Browser terminal (make terminal / make terminal-docker).
# WARNING: ttyd has no authentication. Use only on localhost or Tailscale (private tailnet).
# Do not expose this port to the public Internet without auth and TLS.
TTYD_PORT=7681
TTYD_HOST_PORT=7681
# xterm.js font size in the browser (default ttyd/xterm is ~15; 22 is better on phones)
TTYD_FONT_SIZE=22
