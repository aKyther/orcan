# Host user mapping (orcan sync fills these from the host)
USER_UID=1000
USER_GID=1000

# Docker socket group on the host (used only by orcan up --with-docker)
DOCKER_GID=999

# Timezone — orcan sync copies the host zone (e.g. Europe/Warsaw). Compose also
# bind-mounts /etc/localtime. Override here only if you want a different TZ.
# TZ=Europe/Warsaw

# Git identity — orcan sync copies host `git config --global user.name/email`.
# Commits inside the container then match host author/committer.
# SSH keys / agent are NOT mounted by sync — use: orcan up --with-git
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# Orcan install on host (where you run orcan). NOT the agent/tmux start directory.
# Agent starts in CONTAINER_PROJECT_DIR / WORKSPACE_ROOT (see orcan context show).
# Multi-workspace setups: use orcan.config.json (see orcan.config.example.json).
PROJECT_DIR=/absolute/path/to/orcan

# Generated by orcan sync — default workspace root inside the container
# CONTAINER_PROJECT_DIR=/home/developer/workspaces/my-workspace

# Generated by orcan sync (do not edit by hand unless needed)
# ORCAN_CONFIG_HOST=./.orcan/runtime-config.json
# ORCAN_CONFIG=/etc/orcan/config.json
# ORCAN_COMPOSE_PROJECTS=./.orcan/compose-projects.generated.yml

# Resource limits (host-specific — orcan sync does NOT overwrite once set).
# Light laptop-friendly defaults; raise in orcan.config.json → orcan sync (or edit .env).
CPUS=2
MEMORY=4g
SHM_SIZE=512m
TMPFS_SIZE=512m

# Compose project / container name. Default container: orcan-1
# (set ORCAN_INSTANCE=2 → orcan-2 if you run a second stack with another project name).
# COMPOSE_PROJECT_NAME=orcan
# ORCAN_INSTANCE=1

# Browser terminal (orcan up / orcan up --with-docker).
# WARNING: ttyd has no authentication. Use only on localhost or Tailscale (private tailnet).
# Do not expose this port to the public Internet without auth and TLS.
TTYD_PORT=7681
TTYD_HOST_PORT=7681
# Browser terminal font size (xterm.js). Edit .env — orcan sync does not overwrite once set.
TTYD_FONT_SIZE=19
# Optional font / theme (defaults applied in cursor-ttyd if unset). Quote if commas.
# TTYD_FONT_FAMILY="Menlo, Monaco, 'Courier New', monospace"
# theme presets: dark|navy (default navy/cyan), mocha (legacy Catppuccin), or raw JSON.
TTYD_THEME=dark
# WebSocket ping interval (seconds). ~20 keeps cellular NAT; ttyd default was 5.
TTYD_PING_INTERVAL=20

# Host data root — always used (like poetry under ~/.config/pypoetry).
# orcan sync creates this tree and writes the absolute path below.
# Override only if you need a non-default location:
ORCAN_DATA=

# Optional: Compose image (default orcan:latest = both agents)
# IMAGE_LOCAL=orcan:latest
# IMAGE_LOCAL=orcan:0.1.1-claude   # after: orcan build --claude
# IMAGE_LOCAL=orcan:0.1.1-cursor   # after: orcan build --cursor
# Build: orcan build → latest + <VERSION>; --claude/--cursor → <VERSION>-claude|cursor

# Optional registry (manual publish only — not part of orcan build).
# orcan build: pull IMAGE_TAG (default VERSION); on miss build locally. Never pushes.
# Maintainers: orcan publish
# IMAGE_LOCAL=orcan:latest
# IMAGE_REGISTRY=ghcr.io
# IMAGE_REPOSITORY=akyther/orcan
# IMAGE_TAG=   # empty → use VERSION file
# Do not commit tokens.
